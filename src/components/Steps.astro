---
const steps = [
  { n: 1, title: "ENVÍO DE ARCHIVOS", detail: "Prescripción, escaneo STL, radiografías y fotografías.", note: "goalignerhn@gmail.com", icon: "doc", accent: "from-violet-400 to-indigo-400" },
  { n: 2, title: "SETUP DIGITAL", detail: "Plan de tratamiento, cotización.", icon: "chart", accent: "from-sky-400 to-blue-500" },
  { n: 3, title: "MODIFICACIONES", detail: "Observaciones y detalles · 3 días hábiles.", icon: "search", accent: "from-fuchsia-400 to-violet-500" },
  { n: 4, title: "AUTORIZACIÓN", detail: "Realización de pago.", icon: "money", accent: "from-emerald-400 to-teal-500" },
  { n: 5, title: "ALINEADORES LISTOS", detail: "Entrega en 7 días hábiles.", icon: "aligner", accent: "from-amber-400 to-orange-500" },
];
---

<section id="proceso" class="relative overflow-hidden py-16 md:py-20 text-white bg-neutral-950">
  <!-- fondo -->
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="absolute inset-0 bg-[radial-gradient(120%_80%_at_50%_-10%,#0f0b15,transparent_60%),linear-gradient(180deg,#08090b,#0a0a0f_35%,#0b0a10_70%,#0a0a0f)]"></div>
    <div class="absolute inset-0 opacity-[0.06]" style="background-image:repeating-linear-gradient(110deg,rgba(168,85,247,.7) 0 1px,transparent 1px 12px)"></div>
    <div class="absolute -top-24 -left-24 w-[26rem] h-[26rem] bg-[#7c3aed]/20 blur-3xl rounded-full"></div>
    <div class="absolute bottom-[-6rem] right-[-6rem] w-[24rem] h-[24rem] bg-[#2563eb]/20 blur-3xl rounded-full"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6">
    <!-- header -->
    <div class="text-center mb-8">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/5 px-3 py-1 text-sm text-neutral-200 backdrop-blur border border-white/10">
        Procedimiento
      </span>
      <h2 class="mt-3 text-3xl md:text-5xl font-bold tracking-tight">Paso a paso</h2>
    </div>

<!-- NAV: chips numerados -->
<div class="chips-wrap mt-2 -mx-4 px-2 md:px-4 overflow-x-auto no-scrollbar">
<div
  role="tablist"
  aria-label="Proceso GO ALIGNER"
  class="flex items-center gap-2 md:gap-3 w-max mx-auto md:mx-0 md:w-auto justify-center"
>
  {steps.map((s, i) => (
    <button
      id={`tab-${i}`}
      role="tab"
      aria-selected={i === 0 ? "true" : "false"}
      aria-controls={`panel-${i}`}
      tabindex={i === 0 ? "0" : "-1"}
      class="step-chip group relative inline-flex items-center gap-2 rounded-2xl border border-white/10 bg-white/5 hover:bg-white/10
             px-4 py-3 text-sm transition aria-selected:bg-white/15 aria-selected:border-white/20
             min-w-12 min-h-12"  
      data-step={i}
    >
      <span class="grid place-items-center size-6 rounded-full font-bold text-neutral-900 bg-white shadow">
        {s.n}
      </span>
      <span class="text-white/90">{s.title}</span>
    </button>
  ))}
</div>
</div>

<!-- barra de progreso (un pelín más visible) -->
<div class="mt-4 mx-auto max-w-3xl h-1.5 rounded-full bg-white/10 overflow-hidden">
  <div class="progress h-full w-0 bg-gradient-to-r from-violet-400 to-blue-500"></div>
</div>


    <!-- PANEL contenedor (altura auto animada) -->
    <div class="panel-wrap relative mt-8 md:mt-10 rounded-3xl border border-white/10 bg-white/5 backdrop-blur-md overflow-hidden">

  <!-- “visual” abstracto superior -->
  <div id="visualBox" class="relative h-28 sm:h-32 md:h-36">
    <div id="visual-bg" class="absolute inset-0 bg-gradient-to-br from-violet-400 to-indigo-400 opacity-80"></div>

    <!-- textura + máscara cross-browser -->
    <div
      class="absolute inset-0 mix-blend-overlay opacity-70"
      style="
        --mask: radial-gradient(120% 100% at 50% 0%, black, transparent 70%);
        background:
          radial-gradient(60% 70% at 20% 30%, rgba(255,255,255,.25), transparent 60%),
          radial-gradient(70% 60% at 80% 70%, rgba(255,255,255,.15), transparent 60%),
          repeating-linear-gradient(135deg, rgba(255,255,255,.12) 0 2px, transparent 2px 10px);
        -webkit-mask-image: var(--mask);
        mask-image: var(--mask);
      ">
    </div>

    <!-- icono centrado -->
    <div class="relative z-10 h-full grid place-items-center">
      <div class="size-12 sm:size-14 grid place-items-center rounded-2xl bg-white/15 border border-white/20 backdrop-blur">
        <div id="visual-icon" class="text-2xl"></div>
      </div>
    </div>
  </div>

      <!-- panels (todos renderizados, se ocultan) -->
      <div class="relative">
        {steps.map((s, i) => (
          <section
            id={`panel-${i}`}
            class={`panel px-6 md:px-8 py-6 md:py-7 ${i === 0 ? "relative" : "absolute inset-0 opacity-0 pointer-events-none"}`}
            data-accent={s.accent}
            data-icon={s.icon}
          >
            <div class="flex items-start gap-4 py-2">
              <div class="shrink-0">
                <div class={`size-10 grid place-items-center rounded-xl bg-gradient-to-br ${s.accent} text-neutral-900 font-bold shadow-[0_0_14px_rgba(139,92,246,.45),0_0_22px_rgba(59,130,246,.35)]`}>
                  {s.n}
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-lg md:text-xl font-semibold">{s.title}</h3>
                <p class="text-neutral-300 mt-1 leading-relaxed">{s.detail}</p>
                {s.note && (
                  <p class="text-sm mt-2 opacity-90">
                    <span class="inline-flex items-center gap-2">
                      <i class="fa-regular fa-envelope"></i>
                      <button class="copy-mail underline underline-offset-4 decoration-white/40 hover:decoration-white" data-mail={s.note} title="Copiar correo">
                        {s.note}
                      </button>
                    </span>
                  </p>
                )}
              </div>
            </div>
          </section>
        ))}
      </div>
    </div>

    <!-- hint -->
    <p class="mt-4 text-center text-sm text-white/60">Usa las flechas del teclado ← → o haz clic en cada paso.</p>
  </div>
</section>

<!-- Font Awesome Free en tu layout global -->
<!-- <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" /> -->

<script>
  import gsap from "gsap";

  if (typeof window !== "undefined") {
    const chips   = Array.from(document.querySelectorAll(".step-chip")) as HTMLButtonElement[];
    const panels  = Array.from(document.querySelectorAll(".panel")) as HTMLElement[];
    const progress = document.querySelector(".progress") as HTMLElement;
    const visualBg = document.getElementById("visual-bg") as HTMLElement;
    const visualBox = document.getElementById("visualBox") as HTMLElement;
    const visualIcon = document.getElementById("visual-icon") as HTMLElement;
    const wrap = document.querySelector(".panel-wrap") as HTMLElement;

    const iconTpl = {
      doc: `<svg viewBox="0 0 24 24" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>`,
      chart:`<svg viewBox="0 0 24 24" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 21H4.6c-.56 0-.84 0-1.054-.109a1 1 0 0 1-.437-.437C3 20.24 3 19.96 3 19.4V3"/><path d="m7 14 4-4 4 4 6-6"/><path d="M18 8h3v3"/></svg>`,
      search:`<svg viewBox="0 0 24 24" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6"/><path d="M8 11h6"/></svg>`,
      money:`<svg viewBox="0 0 24 24" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><path d="M12 12a3 3 0 1 0 0-1 3 3 0 0 0 0 1Z"/><path d="M2 10h2"/><path d="M20 10h2"/><path d="M2 14h2"/><path d="M20 14h2"/></svg>`,
      aligner:`<svg viewBox="0 0 24 24" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 12c1.5-3 3.5-4.5 5-4.5s3.5 1.5 5 4.5c-1.5 3-3.5 4.5-5 4.5S8.5 15 7 12Z"/><path d="M2 12c2-5 5.5-8 10-8s8 3 10 8c-2 5-5.5 8-10 8s-8-3-10-8Z"/><circle cx="12" cy="12" r="1"/></svg>`
    };

    let index = 0;

    // altura = visual + panel activo
    const setHeight = (pane:any) => {
      const hVisual = visualBox?.offsetHeight || 0;
      const hPanel  = pane?.offsetHeight || 0;
      const h = hVisual + hPanel;
      gsap.set(wrap, { height: h }); // set inmediato evita parpadeo
      gsap.to(wrap, { height: h, duration: 0.35, ease: "power2.out" });
    };

    const setActiveChip = (i:number) => {
      chips.forEach((c, k) => c.setAttribute("aria-selected", k === i ? "true" : "false"));
    };

    const updateProgress = (i:number) => {
      const pct = i / (panels.length - 1);
      gsap.to(progress, { width: `${pct * 100}%`, duration: 0.35, ease: "power2.out" });
    };

    const swapVisual = (pane:any) => {
      const accent = pane.dataset.accent;
      const icon = pane.dataset.icon as keyof typeof iconTpl;
      visualBg.className = `absolute inset-0 bg-gradient-to-br ${accent} opacity-80`;
      visualIcon.innerHTML = iconTpl[icon] || iconTpl.doc;
      gsap.fromTo(visualIcon, { y: 6, opacity: 0 }, { y: 0, opacity: 1, duration: .3, ease: "power2.out" });
    };

    const showPanel = (to:any) => {
      if (to === index || to < 0 || to >= panels.length) return;
      const fromPane = panels[index];
      const toPane   = panels[to];
      index = to;

      gsap.timeline()
        .set(toPane, { position: "relative", pointerEvents: "auto" })
        .to(fromPane, { opacity: 0, y: 8, duration: .2, ease: "power1.out", onComplete: () => {
          fromPane.style.position = "absolute";
          fromPane.style.pointerEvents = "none";
        }})
        .fromTo(toPane, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: .3, ease: "power2.out" }, "<0.05");

      setHeight(toPane);
      setActiveChip(index);
      updateProgress(index);
      swapVisual(toPane);
      history.replaceState(null, "", `#step-${index+1}`);
    };

    // init
    visualIcon.innerHTML = iconTpl[panels[0]?.dataset?.icon as keyof typeof iconTpl] || iconTpl.doc;
    setTimeout(() => setHeight(panels[0]), 0);

    chips.forEach((c) => c.addEventListener("click", () => showPanel(+(c.dataset.step || 0))));
    window.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") showPanel(index + 1);
      if (e.key === "ArrowLeft")  showPanel(index - 1);
    });

    // deep-link
    const hash = location.hash.match(/step-(\d+)/);
    if (hash) {
      const i = Math.min(Math.max(parseInt(hash[1], 10) - 1, 0), panels.length - 1);
      if (i) { showPanel(i); }
    }

    // util: ocultar scrollbar de chips en navegadores comunes
    document.querySelectorAll('.no-scrollbar').forEach(el => {
      (el as HTMLElement).style.scrollbarWidth = 'none'; // Firefox
      (el as HTMLElement).style.setProperty('-ms-overflow-style', 'none'); // IE/Edge
      el.addEventListener('wheel', (e)=> {
        // scroll suave horizontal con wheel
        const wheelEvent = e as WheelEvent;
        if (Math.abs(wheelEvent.deltaY) > Math.abs(wheelEvent.deltaX)) {
          (el as HTMLElement).scrollLeft += wheelEvent.deltaY * 0.5;
        }
      }, { passive: true });
    });
  }
</script>

