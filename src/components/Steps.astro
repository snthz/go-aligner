---
const steps = [
  { n: 1, title: "Envío de archivos", detail: "Prescripción, escaneo STL, radiografías y fotografías.", note: "goalignerhn@gmail.com" },
  { n: 2, title: "Setup digital", detail: "Plan de tratamiento y cotización del caso." },
  { n: 3, title: "Modificaciones", detail: "Observaciones y ajustes · 3 días hábiles." },
  { n: 4, title: "Autorización", detail: "Aprobación del plan y realización del pago." },
  { n: 5, title: "Alineadores listos", detail: "Fabricación y entrega en 7 días hábiles." },
];
---

<section id="proceso" class="relative overflow-hidden bg-[#0a0a0b] py-24 text-white md:py-32">
  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <!-- header -->
    <div class="max-w-2xl">
      <span class="eyebrow text-violet-300">Proceso</span>
      <h2 class="mt-5 text-balance text-4xl font-medium tracking-tight md:text-5xl">
        Paso a paso, sin fricción.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-neutral-400">
        Un flujo claro desde el envío del caso hasta la entrega de tus alineadores.
      </p>
    </div>

    <!-- timeline -->
    <ol class="relative mt-16 grid gap-y-12 md:grid-cols-5 md:gap-x-6">
      <!-- connecting line (desktop) -->
      <div aria-hidden="true" class="pointer-events-none absolute left-0 right-0 top-[1.375rem] hidden h-px bg-gradient-to-r from-violet-500/10 via-violet-500/40 to-violet-500/10 md:block"></div>

      {steps.map((s) => (
        <li class="step-item relative">
          <div class="flex size-11 items-center justify-center rounded-full border border-violet-400/30 bg-[#0a0a0b] text-lg font-medium text-violet-300">
            {s.n}
          </div>
          <h3 class="mt-6 text-lg font-medium leading-snug">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-400">{s.detail}</p>
          {s.note && (
            <button
              class="copy-mail mt-3 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs text-neutral-300 transition-colors hover:bg-white/[0.07]"
              data-mail={s.note}
              title="Copiar correo"
            >
              <i class="fa-regular fa-envelope text-violet-300"></i>
              <span class="mail-label">{s.note}</span>
            </button>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReduced) {
    gsap.utils.toArray<HTMLElement>(".step-item").forEach((el, i) => {
      gsap.fromTo(el,
        { opacity: 0, y: 18 },
        {
          opacity: 1, y: 0, duration: 0.5, delay: i * 0.07, ease: "power2.out",
          scrollTrigger: { trigger: el, start: "top 90%" },
        }
      );
    });
  }

  /* Copy email to clipboard */
  document.querySelectorAll<HTMLButtonElement>(".copy-mail").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const mail = btn.dataset.mail ?? "";
      try {
        await navigator.clipboard.writeText(mail);
        const label = btn.querySelector(".mail-label") as HTMLElement;
        const original = label.textContent;
        label.textContent = "¡Copiado!";
        setTimeout(() => { label.textContent = original; }, 1600);
      } catch { /* clipboard unavailable */ }
    });
  });
</script>
