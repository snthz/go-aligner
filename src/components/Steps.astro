---
interface Step {
  title: string;
  detail: string;
  icon?: string;
  note?: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  steps: Step[];
  link?: { href: string; text: string };
}

const { id, eyebrow, title, description, steps, link } = Astro.props;

// Tailwind necesita clases literales
const cols: Record<number, string> = { 3: "md:grid-cols-3", 4: "md:grid-cols-4", 5: "md:grid-cols-5" };
---

<section id={id} class:list={["relative overflow-hidden bg-[#0a0a0b] text-white", title ? "py-24 md:py-32" : "pb-24 pt-16 md:pb-32 md:pt-20"]}>
  <div class="relative z-10 mx-auto max-w-6xl px-6">
    {title && (
      <div class="mb-16 max-w-2xl">
        {eyebrow && <span class="eyebrow text-violet-300">{eyebrow}</span>}
        <h2 class="mt-5 text-balance text-4xl font-medium tracking-tight md:text-5xl">{title}</h2>
        {description && <p class="mt-5 text-lg leading-relaxed text-neutral-400">{description}</p>}
      </div>
    )}

    <!-- timeline -->
    <ol class:list={["relative grid gap-y-12 md:gap-x-6", cols[steps.length]]}>
      <!-- connecting line (desktop) -->
      <div aria-hidden="true" class="pointer-events-none absolute left-0 right-0 top-[1.375rem] hidden h-px bg-gradient-to-r from-violet-500/10 via-violet-500/40 to-violet-500/10 md:block"></div>

      {steps.map((s, i) => (
        <li class="step-item relative">
          <div class="flex size-11 items-center justify-center rounded-full border border-violet-400/30 bg-[#0a0a0b] text-lg font-medium text-violet-300">
            {s.icon ? <i class={`fa-solid ${s.icon} text-base`} aria-hidden="true"></i> : i + 1}
          </div>
          {s.icon && <p class="mt-5 text-xs font-medium uppercase tracking-[0.18em] text-neutral-500">Paso {i + 1}</p>}
          <h3 class:list={["text-lg font-medium leading-snug", s.icon ? "mt-2" : "mt-6"]}>{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-400">{s.detail}</p>
          {s.note && (
            <button
              class="copy-mail mt-3 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs text-neutral-300 transition-colors hover:bg-white/[0.07]"
              data-mail={s.note}
              title="Copiar correo"
            >
              <i class="fa-regular fa-envelope text-violet-300"></i>
              <span class="mail-label">{s.note}</span>
            </button>
          )}
        </li>
      ))}
    </ol>

    {link && (
      <a href={link.href} class="group mt-14 inline-flex items-center gap-2 text-sm font-medium text-violet-300 transition-colors hover:text-white">
        {link.text}
        <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" /></svg>
      </a>
    )}
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReduced) {
    gsap.utils.toArray<HTMLElement>(".step-item").forEach((el, i) => {
      gsap.fromTo(el,
        { opacity: 0, y: 18 },
        {
          opacity: 1, y: 0, duration: 0.5, delay: i * 0.07, ease: "power2.out",
          scrollTrigger: { trigger: el, start: "top 90%" },
        }
      );
    });
  }

  /* Copy email to clipboard */
  document.querySelectorAll<HTMLButtonElement>(".copy-mail").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const mail = btn.dataset.mail ?? "";
      try {
        await navigator.clipboard.writeText(mail);
        const label = btn.querySelector(".mail-label") as HTMLElement;
        const original = label.textContent;
        label.textContent = "¡Copiado!";
        setTimeout(() => { label.textContent = original; }, 1600);
      } catch { /* clipboard unavailable */ }
    });
  });
</script>
