---
import { Image } from "astro:assets";
import Machine1 from "../assets/machine1.webp";
import Machine2 from "../assets/machine2.webp";
import Machine3 from "../assets/machine3.webp";

const techItems = [
  {
    img: Machine1,
    title: "Resinas Tera Harz",
    description: "Material certificado de alta resistencia, diseñado para alineadores duraderos y seguros.",
    alt: "Resina Tera Harz utilizada en la fabricación de alineadores invisibles GO ALIGNER",
  },
  {
    img: Machine2,
    title: "Cámara de curado",
    description: "Garantiza precisión y resistencia óptima en cada alineador fabricado.",
    alt: "Cámara de curado UV para alineadores dentales en laboratorio GO ALIGNER",
  },
  {
    img: Machine3,
    title: "Generador de nitrógeno",
    description: "Optimiza el curado, reduciendo impurezas y mejorando la calidad final.",
    alt: "Generador de nitrógeno para proceso de curado de alineadores GO ALIGNER",
  },
];
---

<section id="tecnologia" class="relative overflow-hidden bg-[#0a0a0b] py-24 text-white md:py-32">
  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <h2 class="text-balance text-4xl font-medium tracking-tight md:text-5xl">
        Maquinaria de última generación.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-neutral-400">
        Materiales y equipos de vanguardia que garantizan precisión, durabilidad y calidad en cada alineador.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
      {techItems.map((item) => (
        <article class="tech-card group overflow-hidden rounded-3xl border border-white/10 bg-white/[0.02]">
          <div class="relative aspect-[4/3] overflow-hidden">
            <Image
              src={item.img}
              alt={item.alt}
              widths={[360, 540, 720, 1024]}
              sizes="(min-width: 768px) 352px, (min-width: 640px) 50vw, 100vw"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0b]/60 to-transparent"></div>
          </div>
          <div class="p-7">
            <h3 class="text-xl font-medium tracking-tight">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-neutral-400">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReduced) {
    ScrollTrigger.batch(".tech-card", {
      onEnter: (batch) =>
        gsap.fromTo(batch,
          { opacity: 0, y: 22 },
          { opacity: 1, y: 0, duration: 0.55, stagger: 0.07, ease: "power2.out" }
        ),
      start: "top 90%",
      once: true,
    });
  }
</script>
