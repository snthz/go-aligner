---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<section class="relative overflow-hidden bg-[#0a0a0b] pb-24 pt-16 text-white md:pb-32 md:pt-20">
  <div class="mx-auto max-w-3xl px-6">
    <div class="divide-y divide-white/10 rounded-3xl border border-white/10 bg-white/[0.02]">
      {items.map((item) => (
        <details class="faq-item group px-7 py-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-medium leading-snug">
            {item.question}
            <span class="grid size-8 shrink-0 place-items-center rounded-full border border-white/15 text-violet-300 transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            </span>
          </summary>
          <p class="mt-4 max-w-2xl leading-relaxed text-neutral-400">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
