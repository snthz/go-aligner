---
export interface Testimonial {
  quote: string;
  name: string;
  age: number;
  /** p. ej. "8 meses de tratamiento" */
  duration: string;
}

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
---

{testimonials.length > 0 && (
  <section class="relative overflow-hidden bg-[#f7f8fa] pb-24 text-neutral-900 md:pb-32">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-balance text-4xl font-medium tracking-tight md:text-5xl">Testimonios</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {testimonials.map((t) => (
          <figure class="flex flex-col justify-between rounded-3xl border border-neutral-200 bg-white p-8 shadow-[0_1px_2px_rgba(0,0,0,.04)]">
            <blockquote class="text-lg leading-relaxed text-neutral-700">“{t.quote}”</blockquote>
            <figcaption class="mt-6 text-sm">
              <span class="font-medium text-neutral-900">{t.name}, {t.age} años</span>
              <span class="block text-neutral-500">{t.duration}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
