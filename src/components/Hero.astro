---
import { Image } from "astro:assets";
import AlignerTransparent from "../assets/aligner-transparent.png";
---

<section id="hero" class="relative min-h-dvh overflow-hidden bg-neutral-950 text-white flex items-center">
  <!-- Fondo: gradientes multicapa + grid + noise -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0"
    style="background: radial-gradient(60% 50% at 50% 35%, rgba(124,58,237,.14) 0%, transparent 70%), radial-gradient(40% 40% at 70% 60%, rgba(99,102,241,.08) 0%, transparent 60%), radial-gradient(35% 35% at 25% 65%, rgba(6,182,212,.06) 0%, transparent 55%);"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 opacity-[0.03]"
    style="background-image: radial-gradient(circle, rgba(255,255,255,0.8) 1px, transparent 1px); background-size: 64px 64px;"
  ></div>
  <!-- Noise grain -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 opacity-[0.025] mix-blend-overlay"
    style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27n%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.9%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23n)%27/%3E%3C/svg%3E'); background-size: 200px 200px;"
  ></div>

  <!-- Central glow -->
  <div
    aria-hidden="true"
    class="absolute z-[1] top-[42%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-[50rem] h-[50rem] max-w-[90vw] max-h-[90vw] rounded-full blur-[120px] bg-violet-500/[.07]"
  ></div>
  <div
    aria-hidden="true"
    class="absolute z-[1] top-[55%] left-[60%] -translate-x-1/2 -translate-y-1/2 w-[30rem] h-[30rem] rounded-full blur-[100px] bg-indigo-500/[.04]"
  ></div>

  <div class="relative z-10 max-w-screen-xl mx-auto px-5 md:px-8 w-full grid grid-cols-1 md:grid-cols-2 items-center gap-12 py-28 md:py-36">

    <!-- Left: Copy -->
    <div class="text-center md:text-left">
      <span class="hero-badge inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[.04] px-4 py-1.5 text-sm text-neutral-300 backdrop-blur-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" class="opacity-60" fill="none">
          <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.64 5.64l2.12 2.12M16.24 16.24l2.12 2.12M5.64 18.36l2.12-2.12M16.24 7.76l2.12-2.12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        Ortodoncia digital de última generación
      </span>

      <h1 class="hero-headline mt-6 text-4xl sm:text-5xl md:text-[3.5rem] font-medium leading-[1.08] tracking-tight">
        Alineadores invisibles,<br>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 via-indigo-400 to-cyan-400">precisos y cómodos.</span>
      </h1>

      <p class="hero-sub mt-5 text-neutral-300 text-base md:text-lg leading-relaxed max-w-lg mx-auto md:mx-0">
        Diseño, fabricación y seguimiento con flujo 100&percnt; digital. Resultados predecibles con menos citas y más control.
      </p>

      <!-- CTAs -->
      <div class="hero-ctas mt-8 flex flex-col sm:flex-row items-center gap-3 sm:gap-4 justify-center md:justify-start">
        <a
          href="https://wa.link/42atxt"
          target="_blank"
          rel="noopener"
          class="cta-primary group inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-violet-600 to-indigo-600 px-6 py-3.5 font-medium text-white shadow-lg shadow-violet-600/20 hover:shadow-violet-600/35 hover:brightness-110 transition-all duration-300"
        >
          Solicitar evaluación
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </a>

      </div>

      <!-- Feature chips -->
      <div class="hero-chips mt-7 flex flex-wrap items-center gap-2.5 justify-center md:justify-start">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/[.04] border border-white/8 px-3.5 py-1.5 text-xs text-neutral-400">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Plan 3D personalizado
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/[.04] border border-white/8 px-3.5 py-1.5 text-xs text-neutral-400">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Seguimiento online
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/[.04] border border-white/8 px-3.5 py-1.5 text-xs text-neutral-400">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Material shape memory
        </span>
      </div>
    </div>

    <!-- Right: Aligner image -->
    <div class="relative justify-self-center md:justify-self-end">
      <div aria-hidden="true" class="absolute inset-0 -z-[1] flex items-center justify-center">
        <div class="w-[clamp(300px,52vw,600px)] h-[clamp(300px,52vw,600px)] rounded-full border border-white/[.06] [mask-image:radial-gradient(closest-side,black,transparent)]"></div>
      </div>

      <div id="aligner-wrap" class="relative w-[clamp(260px,55vw,580px)] h-[clamp(260px,55vw,580px)] grid place-items-center">
        <Image
          src={AlignerTransparent}
          alt="Alineador dental transparente GO ALIGNER fabricado con tecnología de memoria de forma"
          class="w-full h-full object-contain drop-shadow-[0_20px_60px_rgba(0,0,0,.5)] will-change-transform"
          loading="eager"
          decoding="async"
        />

        <span aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-full border border-white/[.06] rotate-12"></span>
        <span aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-full border border-white/[.06] -rotate-6"></span>

        <div class="absolute -left-3 md:-left-6 top-[18%]">
          <div class="badge-float rounded-xl border border-white/10 bg-white/[.07] backdrop-blur-sm px-3 py-2 text-sm text-neutral-200">
            PLAN 3D
          </div>
        </div>
        <div class="absolute right-0 md:-right-4 top-[45%]">
          <div class="badge-float rounded-xl border border-white/10 bg-white/[.07] backdrop-blur-sm px-3 py-2 text-sm text-neutral-200">
            SHAPE MEMORY
          </div>
        </div>
        <div class="absolute left-[15%] bottom-[8%]">
          <div class="badge-float rounded-xl border border-white/10 bg-white/[.07] backdrop-blur-sm px-3 py-2 text-sm text-neutral-200">
            SEGUIMIENTO ONLINE
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Partículas (reducidas) -->
  <div id="hero-particles" class="pointer-events-none absolute inset-0 z-[2]"></div>

  <!-- Scroll indicator -->
  <div class="hero-scroll absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex items-center gap-2.5">
    <div class="w-5 h-8 rounded-full border border-white/20 relative">
      <span id="mouse-dot" class="absolute left-1/2 -translate-x-1/2 top-1.5 h-1 w-1 rounded-full bg-white/80"></span>
    </div>
    <span class="text-xs text-neutral-500">Desliza</span>
  </div>
</section>

<style>
  .badge-float { transform: translateY(0) translateZ(0); }
</style>

<script>
  import gsap from "gsap";

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReduced) {
    /* ── Hero entrance timeline (snappy, minimal) ── */
    const tl = gsap.timeline({ defaults: { ease: "power2.out" } });

    tl.fromTo(".hero-badge",
      { opacity: 0, y: 10 },
      { opacity: 1, y: 0, duration: 0.5 }
    )
    .fromTo(".hero-headline",
      { opacity: 0, y: 16 },
      { opacity: 1, y: 0, duration: 0.6 },
      "-=0.25"
    )
    .fromTo(".hero-sub",
      { opacity: 0, y: 10 },
      { opacity: 1, y: 0, duration: 0.5 },
      "-=0.3"
    )
    .fromTo(".hero-ctas > a",
      { opacity: 0, y: 10 },
      { opacity: 1, y: 0, stagger: 0.08, duration: 0.4 },
      "-=0.25"
    )
    .fromTo(".hero-chips > span",
      { opacity: 0 },
      { opacity: 1, stagger: 0.05, duration: 0.35 },
      "-=0.15"
    )
    .fromTo("#aligner-wrap",
      { opacity: 0, scale: 0.96 },
      { opacity: 1, scale: 1, duration: 0.7 },
      "-=0.6"
    )
    .fromTo(".badge-float",
      { opacity: 0 },
      { opacity: 1, stagger: 0.06, duration: 0.4 },
      "-=0.3"
    )
    .fromTo(".hero-scroll",
      { opacity: 0 },
      { opacity: 1, duration: 0.4 },
      "-=0.2"
    );

    /* ── Aligner subtle float ── */
    gsap.to("#aligner-wrap img", {
      y: -14,
      rotation: 1.5,
      duration: 3.5,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut",
    });

    /* ── Mouse parallax on image ── */
    const wrap = document.getElementById("aligner-wrap") as HTMLElement;
    const section = wrap?.closest("section");
    if (wrap && section) {
      section.addEventListener("mousemove", (e) => {
        const rect = section.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        gsap.to(wrap, {
          x: x * 16,
          y: y * 10,
          rotateX: y * 3,
          rotateY: -x * 5,
          transformPerspective: 800,
          transformOrigin: "center",
          duration: 0.6,
          ease: "sine.out",
        });
      });
      section.addEventListener("mouseleave", () => {
        gsap.to(wrap, { x: 0, y: 0, rotateX: 0, rotateY: 0, duration: 0.6, ease: "sine.out" });
      });
    }

    /* ── Badge float ── */
    (gsap.utils.toArray(".badge-float") as HTMLElement[]).forEach((el, i) => {
      gsap.to(el, {
        y: i % 2 === 0 ? -8 : -5,
        duration: 2.8 + i * 0.2,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
        delay: i * 0.3,
      });
    });

    /* ── Mouse dot scroll indicator ── */
    gsap.to("#mouse-dot", {
      y: 12,
      duration: 1.4,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut",
    });

    /* ── Particles (varied sizes, violet/indigo glow) ── */
    const particles = document.getElementById("hero-particles") as HTMLElement;
    const pData = [
      { top: "12%", left: "15%", size: 3, color: "rgba(139,92,246,.6)", op: 0.7 },
      { top: "8%",  left: "65%", size: 2, color: "rgba(139,92,246,.4)", op: 0.5 },
      { top: "30%", left: "80%", size: 4, color: "rgba(99,102,241,.5)", op: 0.6 },
      { top: "55%", left: "90%", size: 2.5, color: "rgba(6,182,212,.4)", op: 0.45 },
      { top: "75%", left: "25%", size: 3, color: "rgba(139,92,246,.5)", op: 0.55 },
      { top: "85%", left: "55%", size: 2, color: "rgba(99,102,241,.35)", op: 0.4 },
      { top: "45%", left: "10%", size: 1.5, color: "rgba(6,182,212,.35)", op: 0.35 },
    ];
    pData.forEach((p, i) => {
      const d = document.createElement("div");
      d.className = "absolute rounded-full";
      Object.assign(d.style, {
        top: p.top,
        left: p.left,
        width: `${p.size}px`,
        height: `${p.size}px`,
        background: p.color,
        opacity: String(p.op),
        boxShadow: `0 0 ${p.size * 3}px ${p.color}`,
      });
      particles.appendChild(d);
      gsap.to(d, {
        y: `random(-12,12)`,
        x: `random(-6,6)`,
        duration: 5 + Math.random() * 3,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
        delay: i * 0.4,
      });
    });
  }
</script>
