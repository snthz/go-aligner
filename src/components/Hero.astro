---
import { Image } from "astro:assets";
import AlignerTransparent from "../assets/aligner-transparent.png";
---

<section id="hero" class="relative flex min-h-dvh items-center overflow-hidden bg-[#0a0a0b] text-white">
  <!-- Calm background: single soft halo + faint grid -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0"
    style="background: radial-gradient(70% 55% at 50% 0%, rgba(124,58,237,.16) 0%, transparent 65%);"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 opacity-[0.04]"
    style="background-image: linear-gradient(rgba(255,255,255,.6) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.6) 1px, transparent 1px); background-size: 80px 80px; mask-image: radial-gradient(80% 60% at 50% 30%, black, transparent 80%);"
  ></div>

  <div class="relative z-10 mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-14 px-6 py-32 md:grid-cols-[1.05fr_0.95fr] md:py-36">
    <!-- Left: Copy -->
    <div class="text-center md:text-left">
      <span class="hero-el eyebrow text-violet-300">Ortodoncia digital · Honduras</span>

      <h1 class="hero-el mt-6 text-[2.6rem] font-medium leading-[1.05] tracking-tight sm:text-6xl md:text-[4rem]">
        Tu sonrisa,<br />
        diseñada en <span class="text-violet-400">3D</span>.
      </h1>

      <p class="hero-el mx-auto mt-6 max-w-md text-lg leading-relaxed text-neutral-400 md:mx-0">
        Alineadores invisibles hechos a tu medida: escaneo digital, plan en 3D y seguimiento en línea.
      </p>

      <!-- CTAs -->
      <div class="hero-el mt-9 flex flex-col items-center gap-3 sm:flex-row md:justify-start">
        <a
          href="https://wa.link/42atxt"
          target="_blank"
          rel="noopener"
          class="group inline-flex w-full items-center justify-center gap-2 rounded-full bg-white px-7 py-3.5 font-medium text-neutral-900 transition-colors duration-200 hover:bg-neutral-200 sm:w-auto"
        >
          Solicitar evaluación
          <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" /></svg>
        </a>
        <a
          href="#como-funciona"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-white/15 px-7 py-3.5 font-medium text-white transition-colors duration-200 hover:bg-white/5 sm:w-auto"
        >
          Ver cómo funciona
        </a>
      </div>

      <!-- Quiet stats -->
      <dl class="hero-el mt-12 grid max-w-md grid-cols-3 gap-6 border-t border-white/10 pt-7 text-center md:mx-0 md:text-left">
        <div>
          <dt class="text-2xl font-semibold tracking-tight">7 días</dt>
          <dd class="mt-1 text-xs text-neutral-500">Entrega hábil</dd>
        </div>
        <div>
          <dt class="text-2xl font-semibold tracking-tight">3D</dt>
          <dd class="mt-1 text-xs text-neutral-500">Plan a medida</dd>
        </div>
        <div>
          <dt class="text-2xl font-semibold tracking-tight">100%</dt>
          <dd class="mt-1 text-xs text-neutral-500">Digital</dd>
        </div>
      </dl>
    </div>

    <!-- Right: Aligner image -->
    <div class="relative justify-self-center md:justify-self-end">
      <!-- soft halo -->
      <div
        aria-hidden="true"
        class="absolute left-1/2 top-1/2 -z-[1] h-[34rem] w-[34rem] max-w-[90vw] -translate-x-1/2 -translate-y-1/2 rounded-full"
        style="background: radial-gradient(closest-side, rgba(124,58,237,.18), transparent 70%);"
      ></div>

      <div id="aligner-wrap" class="relative grid h-[clamp(260px,52vw,540px)] w-[clamp(260px,52vw,540px)] place-items-center">
        <Image
          src={AlignerTransparent}
          alt="Alineador dental transparente GO ALIGNER hecho a la medida"
          class="h-full w-full object-contain drop-shadow-[0_30px_60px_rgba(0,0,0,.55)] will-change-transform"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />

        <div class="badge-float absolute -left-2 top-[20%] md:-left-6">
          <div class="rounded-2xl bg-white px-3.5 py-2 text-xs font-medium text-neutral-900 shadow-lg shadow-black/30">
            Plan 3D personalizado
          </div>
        </div>
        <div class="badge-float absolute right-0 top-[48%] md:-right-6">
          <div class="rounded-2xl bg-white px-3.5 py-2 text-xs font-medium text-neutral-900 shadow-lg shadow-black/30">
            Prácticamente invisible
          </div>
        </div>
        <div class="badge-float absolute bottom-[10%] left-[12%]">
          <div class="rounded-2xl bg-white px-3.5 py-2 text-xs font-medium text-neutral-900 shadow-lg shadow-black/30">
            Seguimiento en línea
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-el absolute bottom-7 left-1/2 z-10 flex -translate-x-1/2 items-center gap-2.5">
    <div class="relative h-8 w-5 rounded-full border border-white/20">
      <span id="mouse-dot" class="absolute left-1/2 top-1.5 h-1 w-1 -translate-x-1/2 rounded-full bg-white/80"></span>
    </div>
    <span class="text-xs text-neutral-500">Desliza</span>
  </div>
</section>

<script>
  import gsap from "gsap";

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReduced) {
    const tl = gsap.timeline({ defaults: { ease: "power2.out" } });
    tl.fromTo(".hero-el",
      { opacity: 0, y: 18 },
      { opacity: 1, y: 0, duration: 0.6, stagger: 0.08 }
    )
    .fromTo("#aligner-wrap",
      { opacity: 0, scale: 0.95 },
      { opacity: 1, scale: 1, duration: 0.8 },
      "-=0.7"
    )
    .fromTo(".badge-float",
      { opacity: 0, y: 8 },
      { opacity: 1, y: 0, stagger: 0.1, duration: 0.45 },
      "-=0.35"
    );

    /* Gentle float on the aligner */
    gsap.to("#aligner-wrap img", {
      y: -14,
      duration: 4,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut",
    });

    /* Subtle pointer parallax */
    const wrap = document.getElementById("aligner-wrap") as HTMLElement;
    const section = wrap?.closest("section");
    if (wrap && section) {
      section.addEventListener("mousemove", (e) => {
        const rect = section.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        gsap.to(wrap, { x: x * 14, y: y * 8, duration: 0.7, ease: "sine.out" });
      });
      section.addEventListener("mouseleave", () => {
        gsap.to(wrap, { x: 0, y: 0, duration: 0.7, ease: "sine.out" });
      });
    }

    /* Floating badges */
    (gsap.utils.toArray(".badge-float") as HTMLElement[]).forEach((el, i) => {
      gsap.to(el, {
        y: i % 2 === 0 ? -7 : -4,
        duration: 3 + i * 0.3,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
        delay: i * 0.3,
      });
    });

    gsap.to("#mouse-dot", { y: 12, duration: 1.4, repeat: -1, yoyo: true, ease: "sine.inOut" });
  }
</script>
