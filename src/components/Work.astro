---
import { Image } from "astro:assets";
import PatternSvg from "../assets/pattern.svg";
import Image1 from "../assets/img-1.jpg";
import Image2 from "../assets/img-2.jpg";
import Image3 from "../assets/img-3.jpg";
import Image4 from "../assets/img-4.jpg";
import Image5 from "../assets/img-5.jpg";
import Image6 from "../assets/img-6.jpg";

const images = [
  { src: Image1, alt: "Imagen 1" },
  { src: Image2, alt: "Imagen 2" },
  { src: Image3, alt: "Imagen 3" },
  { src: Image4, alt: "Imagen 4" },
  { src: Image5, alt: "Imagen 5" },
  { src: Image6, alt: "Imagen 6" },
];
---

<section id="nuestro-trabajo" class="relative bg-neutral-950 text-white overflow-hidden py-28">
      <div class="absolute inset-0  pointer-events-none z-20">
        <div class="absolute top-0 left-0 w-full h-20 bg-gradient-to-t from-transparent via-black/30 to-neutral-950"></div>
        <div class="absolute bottom-0 left-0 w-full h-20 bg-gradient-to-b from-transparent via-black/30 to-neutral-950"></div>
    </div>
  <!-- Fondo decorativo con gradiente animado -->
  <div class="absolute inset-0 z-0 bg-gradient-to-br from-violet-900 via-neutral-950 to-cyan-900 animate-gradient"></div>
  <!-- <Image src={PatternSvg} alt="Pattern" class="absolute inset-0 w-full h-full object-cover opacity-[0.03] z-0" /> -->
  <div class="absolute inset-0 pointer-events-none z-0" id="gallery-particles"></div>

  <div class="relative z-10 max-w-screen-xl mx-auto px-6">
    <h2 class="text-4xl md:text-6xl font-bold text-center mb-5">
      Resultados <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-300 to-cyan-300">destacados</span>
    </h2>
    <p class="text-neutral-300 text-lg mb-12 text-center max-w-3xl mx-auto">
      Descubre cómo nuestros alineadores han transformado sonrisas. Cada imagen es un ejemplo de nuestra precisión y compromiso.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      {images.map((image, i) => (
        <div
          class="image-wrapper group relative h-[280px] rounded-3xl overflow-hidden border border-white/10 bg-white/5 backdrop-blur-md shadow-lg hover:shadow-violet-500/40 transition-all duration-500"
          id={`image-${i}`}
        >
          <!-- Imagen con zoom interactivo -->
          <Image
            src={image.src}
            alt={image.alt}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />

          <!-- Glow radial -->
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-[radial-gradient(circle_at_center,rgba(139,92,246,0.25),transparent)] z-10"></div>

          <!-- Reflejo animado -->
          <div class="absolute inset-0 pointer-events-none z-20 overflow-hidden">
            <span class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/20 to-transparent translate-x-[-150%] group-hover:translate-x-[150%] transition-transform duration-[1200ms] ease-in-out"></span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Gradiente inferior -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent pointer-events-none z-0"></div>
</section>

<style>
  @keyframes gradient {
    0% { background-position: 0% 50% }
    50% { background-position: 100% 50% }
    100% { background-position: 0% 50% }
  }
  .animate-gradient {
    background-size: 200% 200%;
    animation: gradient 12s ease infinite;
  }
</style>

<script is:inline>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // Animación diagonal de entrada
  ScrollTrigger.batch(".image-wrapper", {
    onEnter: batch => {
      gsap.fromTo(batch,
        { opacity: 0, x: -40, y: 40, scale: 0.95, filter: "blur(6px)" },
        { opacity: 1, x: 0, y: 0, scale: 1, filter: "blur(0px)", duration: 1, stagger: 0.15, ease: "power3.out" }
      );
    },
    start: "top 90%",
    once: true,
  });

  // Partículas flotantes
  const container = document.getElementById("gallery-particles");
  Array.from({ length: 12 }).forEach(() => {
    const p = document.createElement("div");
    p.classList.add("absolute", "opacity-20");
    p.style.width = "20px";
    p.style.height = "20px";
    p.style.background = "linear-gradient(135deg, rgba(139,92,246,.6), rgba(59,130,246,.6))";
    p.style.clipPath = "polygon(50% 0%, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0% 50%, 40% 40%)";
    p.style.top = `${Math.random() * 90}%`;
    p.style.left = `${Math.random() * 90}%`;
    p.style.transform = `rotate(${Math.random() * 360}deg)`;
    container.appendChild(p);

    gsap.to(p, {
      y: `random(-6,6)`,
      x: `random(-6,6)`,
      rotation: `random(-15,15)`,
      duration: 5,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut",
      delay: Math.random() * 2,
    });
  });
</script>
