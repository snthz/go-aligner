---
import { Image } from "astro:assets";
import Image1 from "../assets/img-1.jpg";
import Image2 from "../assets/img-2.jpg";
import Image3 from "../assets/img-3.jpg";
import Image4 from "../assets/img-4.jpg";
import Image5 from "../assets/img-5.jpg";
import Image6 from "../assets/img-6.jpg";

const images = [
  { src: Image1, alt: "Resultado de alineadores invisibles GO ALIGNER – caso clínico sonrisa frontal" },
  { src: Image2, alt: "Alineador dental transparente colocado en modelo de arco superior" },
  { src: Image3, alt: "Tratamiento de ortodoncia invisible – vista lateral del progreso" },
  { src: Image4, alt: "Resultado final de ortodoncia digital con alineadores GO ALIGNER" },
  { src: Image5, alt: "Proceso de diseño digital 3D de alineadores personalizados" },
  { src: Image6, alt: "Set de alineadores secuenciales listos para entrega" },
];
---

<section id="nuestro-trabajo" class="relative overflow-hidden bg-[#f7f8fa] py-24 text-neutral-900 md:py-32">
  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <span class="eyebrow text-violet-600">Nuestro trabajo</span>
      <h2 class="mt-5 text-balance text-4xl font-medium tracking-tight md:text-5xl">
        Resultados que hablan por sí solos.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-neutral-500">
        Cada caso es un ejemplo de nuestra precisión y compromiso. Toca cualquier imagen para verla en detalle.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {images.map((image, i) => (
        <button
          class="image-wrapper group relative aspect-[4/5] overflow-hidden rounded-3xl bg-neutral-200 shadow-[0_1px_2px_rgba(0,0,0,.06)] transition-shadow duration-500 hover:shadow-[0_20px_50px_rgba(0,0,0,.12)] cursor-zoom-in"
          data-index={i}
          aria-label="Ampliar imagen"
        >
          <Image
            src={image.src}
            alt={image.alt}
            class="gallery-img h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/25 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>
        </button>
      ))}
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 backdrop-blur-sm cursor-zoom-out" role="dialog" aria-modal="true" aria-label="Vista ampliada de imagen">
    <button id="lb-close" class="absolute right-5 top-5 z-10 grid size-10 place-items-center rounded-full border border-white/15 bg-white/10 text-white transition-colors hover:bg-white/20" aria-label="Cerrar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
    <button id="lb-prev" class="absolute left-4 top-1/2 z-10 grid size-10 -translate-y-1/2 place-items-center rounded-full border border-white/15 bg-white/10 text-white transition-colors hover:bg-white/20" aria-label="Anterior">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <button id="lb-next" class="absolute right-4 top-1/2 z-10 grid size-10 -translate-y-1/2 place-items-center rounded-full border border-white/15 bg-white/10 text-white transition-colors hover:bg-white/20" aria-label="Siguiente">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
    </button>
    <img id="lb-img" class="max-h-[85vh] max-w-[90vw] rounded-2xl object-contain shadow-2xl" src="" alt="" />
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReduced) {
    ScrollTrigger.batch(".image-wrapper", {
      onEnter: (batch) =>
        gsap.fromTo(batch,
          { opacity: 0, y: 22 },
          { opacity: 1, y: 0, duration: 0.55, stagger: 0.07, ease: "power2.out" }
        ),
      start: "top 90%",
      once: true,
    });
  }

  /* ── Lightbox ── */
  const lightbox = document.getElementById("lightbox") as HTMLElement;
  const lbImg = document.getElementById("lb-img") as HTMLImageElement;
  const lbClose = document.getElementById("lb-close") as HTMLElement;
  const lbPrev = document.getElementById("lb-prev") as HTMLElement;
  const lbNext = document.getElementById("lb-next") as HTMLElement;
  const galleryImgs = Array.from(document.querySelectorAll(".gallery-img")) as HTMLImageElement[];
  let currentIdx = 0;

  const showImg = () => {
    lbImg.src = galleryImgs[currentIdx].src;
    lbImg.alt = galleryImgs[currentIdx].alt;
  };
  const openLb = (idx: number) => {
    currentIdx = idx;
    showImg();
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
  };
  const closeLb = () => {
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
  };
  const navigate = (dir: number) => {
    currentIdx = (currentIdx + dir + galleryImgs.length) % galleryImgs.length;
    showImg();
  };

  document.querySelectorAll(".image-wrapper").forEach((wrap, i) => {
    wrap.addEventListener("click", () => openLb(i));
  });
  lbClose.addEventListener("click", closeLb);
  lightbox.addEventListener("click", (e) => { if (e.target === lightbox) closeLb(); });
  lbPrev.addEventListener("click", (e) => { e.stopPropagation(); navigate(-1); });
  lbNext.addEventListener("click", (e) => { e.stopPropagation(); navigate(1); });
  document.addEventListener("keydown", (e) => {
    if (lightbox.classList.contains("hidden")) return;
    if (e.key === "Escape") closeLb();
    if (e.key === "ArrowLeft") navigate(-1);
    if (e.key === "ArrowRight") navigate(1);
  });
</script>
