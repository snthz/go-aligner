---
import { Image } from "astro:assets";
import PatternSvg from "../assets/pattern.svg";
import Image1 from "../assets/img-1.jpg";
import Image2 from "../assets/img-2.jpg";
import Image3 from "../assets/img-3.jpg";
import Image4 from "../assets/img-4.jpg";
import Image5 from "../assets/img-5.jpg";
import Image6 from "../assets/img-6.jpg";

const images = [
  { src: Image1, alt: "Resultado de alineadores invisibles GO ALIGNER – caso clínico sonrisa frontal" },
  { src: Image2, alt: "Alineador dental transparente colocado en modelo de arco superior" },
  { src: Image3, alt: "Tratamiento de ortodoncia invisible – vista lateral del progreso" },
  { src: Image4, alt: "Resultado final de ortodoncia digital con alineadores GO ALIGNER" },
  { src: Image5, alt: "Proceso de diseño digital 3D de alineadores personalizados" },
  { src: Image6, alt: "Set de alineadores secuenciales listos para entrega" },
];
---

<section id="nuestro-trabajo" class="relative bg-neutral-950 text-white overflow-hidden py-28">
      <div class="absolute inset-0  pointer-events-none z-20">
        <div class="absolute top-0 left-0 w-full h-24 bg-gradient-to-b from-neutral-950 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full h-24 bg-gradient-to-t from-neutral-950 to-transparent"></div>
    </div>
  <!-- Fondo decorativo con gradiente animado -->
  <div class="absolute inset-0 z-0 bg-gradient-to-br from-violet-900 via-neutral-950 to-cyan-900 animate-gradient"></div>
  <!-- <Image src={PatternSvg} alt="Pattern" class="absolute inset-0 w-full h-full object-cover opacity-[0.03] z-0" /> -->
  <div class="absolute inset-0 pointer-events-none z-0" id="gallery-particles"></div>

  <div class="relative z-10 max-w-screen-xl mx-auto px-6">
    <h2 class="text-4xl md:text-6xl font-semibold text-center mb-5">
      Resultados <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-500 via-indigo-500 to-cyan-500 ">destacados</span>
    </h2>
    <p class="text-neutral-300 text-lg mb-12 text-center max-w-3xl mx-auto">
      Descubre cómo nuestros alineadores han transformado sonrisas. Cada imagen es un ejemplo de nuestra precisión y compromiso.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      {images.map((image, i) => (
        <div
          class="image-wrapper group relative h-[280px] rounded-3xl overflow-hidden border border-white/10 bg-white/5 backdrop-blur-md shadow-lg hover:shadow-violet-500/40 transition-all duration-500 cursor-zoom-in"
          id={`image-${i}`}
          data-index={i}
        >
          <!-- Imagen con zoom interactivo -->
          <Image
            src={image.src}
            alt={image.alt}
            class="gallery-img w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />

          <!-- Glow radial -->
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-[radial-gradient(circle_at_center,rgba(139,92,246,0.25),transparent)] z-10"></div>

          <!-- Reflejo animado -->
          <div class="absolute inset-0 pointer-events-none z-20 overflow-hidden">
            <span class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/20 to-transparent translate-x-[-150%] group-hover:translate-x-[150%] transition-transform duration-[1200ms] ease-in-out"></span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 backdrop-blur-sm cursor-zoom-out" role="dialog" aria-modal="true" aria-label="Vista ampliada de imagen">
    <button id="lb-close" class="absolute top-5 right-5 z-10 size-10 grid place-items-center rounded-full bg-white/10 hover:bg-white/20 border border-white/15 text-white transition-colors" aria-label="Cerrar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <button id="lb-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-10 size-10 grid place-items-center rounded-full bg-white/10 hover:bg-white/20 border border-white/15 text-white transition-colors" aria-label="Anterior">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button id="lb-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-10 size-10 grid place-items-center rounded-full bg-white/10 hover:bg-white/20 border border-white/15 text-white transition-colors" aria-label="Siguiente">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
    </button>
    <img id="lb-img" class="max-h-[85vh] max-w-[90vw] rounded-xl object-contain shadow-2xl" src="" alt="" />
  </div>

  <!-- Gradiente inferior -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent pointer-events-none z-0"></div>
</section>

<style>
  @keyframes gradient {
    0% { background-position: 0% 50% }
    50% { background-position: 100% 50% }
    100% { background-position: 0% 50% }
  }
  .animate-gradient {
    background-size: 200% 200%;
    animation: gradient 12s ease infinite;
  }
</style>

<script >
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReduced) {
    // Animación de entrada
    ScrollTrigger.batch(".image-wrapper", {
      onEnter: batch => {
        gsap.fromTo(batch,
          { opacity: 0, y: 20 },
          { opacity: 1, y: 0, duration: 0.5, stagger: 0.06, ease: "power2.out" }
        );
      },
      start: "top 90%",
      once: true,
    });
  }

  // Partículas flotantes
  if (!prefersReduced) {
    const container = document.getElementById("gallery-particles") as HTMLElement;
  Array.from({ length: 12 }).forEach(() => {
    const p = document.createElement("div");
    p.classList.add("absolute", "opacity-20");
    p.style.width = "20px";
    p.style.height = "20px";
    p.style.background = "linear-gradient(135deg, rgba(139,92,246,.6), rgba(59,130,246,.6))";
    p.style.clipPath = "polygon(50% 0%, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0% 50%, 40% 40%)";
    p.style.top = `${Math.random() * 90}%`;
    p.style.left = `${Math.random() * 90}%`;
    p.style.transform = `rotate(${Math.random() * 360}deg)`;
    container?.appendChild(p);

    gsap.to(p, {
      y: `random(-6,6)`,
      x: `random(-6,6)`,
      rotation: `random(-15,15)`,
      duration: 5,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut",
      delay: Math.random() * 2,
    });
  });
  } // close prefersReduced check

  /* ── Lightbox ── */
  const lightbox = document.getElementById("lightbox") as HTMLElement;
  const lbImg = document.getElementById("lb-img") as HTMLImageElement;
  const lbClose = document.getElementById("lb-close") as HTMLElement;
  const lbPrev = document.getElementById("lb-prev") as HTMLElement;
  const lbNext = document.getElementById("lb-next") as HTMLElement;
  const galleryImgs = Array.from(document.querySelectorAll(".gallery-img")) as HTMLImageElement[];
  let currentIdx = 0;

  const openLb = (idx: number) => {
    currentIdx = idx;
    const img = galleryImgs[idx];
    lbImg.src = img.src;
    lbImg.alt = img.alt;
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
  };

  const closeLb = () => {
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
  };

  const navigate = (dir: number) => {
    currentIdx = (currentIdx + dir + galleryImgs.length) % galleryImgs.length;
    lbImg.src = galleryImgs[currentIdx].src;
    lbImg.alt = galleryImgs[currentIdx].alt;
  };

  document.querySelectorAll(".image-wrapper").forEach((wrap, i) => {
    wrap.addEventListener("click", () => openLb(i));
  });
  lbClose.addEventListener("click", closeLb);
  lightbox.addEventListener("click", (e) => { if (e.target === lightbox) closeLb(); });
  lbPrev.addEventListener("click", (e) => { e.stopPropagation(); navigate(-1); });
  lbNext.addEventListener("click", (e) => { e.stopPropagation(); navigate(1); });
  document.addEventListener("keydown", (e) => {
    if (lightbox.classList.contains("hidden")) return;
    if (e.key === "Escape") closeLb();
    if (e.key === "ArrowLeft") navigate(-1);
    if (e.key === "ArrowRight") navigate(1);
  });
</script>
