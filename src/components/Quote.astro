---
---

<section class="quote-section relative flex items-center justify-center overflow-hidden bg-[#f7f8fa] px-6 py-28 text-neutral-900 md:py-40">
  <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center text-center">
    <span class="quote-el eyebrow text-violet-600">Memoria de forma</span>

    <h2 class="quote-el mt-8 text-balance text-3xl font-medium leading-[1.12] tracking-tight md:text-[3.25rem]">
      Transforma tu práctica ortodóntica con alineadores que
      <span class="text-violet-600">recuerdan su forma</span> y mantienen el control en cada etapa.
    </h2>

    <!-- smile mark -->
    <div class="quote-el mt-14 grid size-14 place-items-center rounded-full bg-violet-100 text-violet-600" aria-hidden="true">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9.25" stroke-width="1.5" opacity="0.35" />
        <path d="M8.2 14c.9 1.3 2.2 2 3.8 2s2.9-.7 3.8-2" stroke-width="1.8" />
        <path d="M9 9.5h.01M15 9.5h.01" stroke-width="2.4" />
      </svg>
    </div>

    <p class="quote-el mt-6 text-base font-medium text-neutral-500">Memoria activa, control constante.</p>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReduced) {
    gsap.fromTo(".quote-el",
      { opacity: 0, y: 20 },
      {
        opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: "power2.out",
        scrollTrigger: { trigger: ".quote-section", start: "top 72%" },
      }
    );
  }
</script>
