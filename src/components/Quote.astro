---
import ShineIcon from '../icons/ShineIcon.astro';
---
  <section class="bg-white px-4 py-20 md:py-32 quote-section">
    <div class="max-w-screen-xl mx-auto py-10 flex flex-col items-center">
      <h2 class="quote-text text-3xl md:text-6xl font-bold text-balance text-center max-w-[20ch]  whitespace-pre-wrap">
        Transforma tu sonrisa con los mejores retenedores dentales.
      </h2>
      <div class="flex items-center mt-6 gap-2 quote-icon">
        <ShineIcon size="20" class="fill-red-400 stroke-red-400 animate-spin " />
        <span class="text-red-400">Sonríe con confianza.</span>
      </div>
    </div>
  </section>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import {SplitText} from 'gsap/SplitText';

    gsap.registerPlugin(ScrollTrigger, SplitText);

    const quoteSection = document.querySelector('.quote-section');
    const quoteText = quoteSection?.querySelector('.quote-text');
    const splitText = new SplitText(quoteText || "", { type: 'lines' });
    const quoteIcon = quoteSection?.querySelector('.quote-icon');
    gsap.from(splitText.lines, {
      scrollTrigger: {
        trigger: quoteSection,
        start: 'top center',
        end: 'bottom center',
        scrub: true,
        once: true,
      },
      y: 10,
      opacity: 0,
      stagger: 0.1,
      ease: 'power2.out',
    });
    gsap.from(quoteIcon || "", {
      scrollTrigger: {
        trigger: quoteSection,
        start: 'top center',
        end: 'bottom center',
        scrub: true,
      },
      y: 50,
      opacity: 0,
      stagger: 0.1, 
      });
  </script>