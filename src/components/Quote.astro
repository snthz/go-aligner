---
import ShineIcon from '../icons/ShineIcon.astro';
---

<section class="bg-white px-4 py-10 md:py-32 quote-section min-h-screen flex items-center justify-center relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none z-0" id="quote-particles"></div>
  <div class="max-w-screen-xl mx-auto flex flex-col items-center text-center z-10 px-2 md:px-4 w-full">
    <!-- Frase principal con efecto scroll profundo -->
    <div class="relative w-full md:max-w-[60ch] min-h-[6em] md:min-h-[8em] flex items-center justify-center mx-auto">
      <h2 class="quote-line text-4xl md:text-6xl font-bold leading-tight tracking-tight text-neutral-700 text-balance">
        Transforma tu sonrisa con los <span class="playfair italic">mejores</span> retenedores dentales.
      </h2>
    </div>

    <!-- Icono -->
    <div class="flex items-center mt-8 gap-3 quote-icon opacity-0 translate-y-8 transition-opacity">
      <ShineIcon size="20" class="fill-red-400 stroke-red-400 animate-spin-slow" />
      <span class="text-red-500 text-base md:text-lg font-medium">Sonríe con confianza.</span>
    </div>
  </div>
</section>

<style>
  .animate-spin-slow {
    animation: spin 6s linear infinite;
  }
</style>

<script>
  import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);

// Efecto "venir desde el fondo"
gsap.from('.quote-line', {
  scrollTrigger: {
    trigger: '.quote-section',
    start: 'top 80%',
    end: 'center center',
    scrub: true,
  },
  opacity: 0,
  scale: 0.85,
  y: 50,
  filter: 'blur(8px)',
  ease: 'power2.out',
});

// Icono aparece al final
gsap.to('.quote-icon', {
  scrollTrigger: {
    trigger: '.quote-section',
    start: 'top 40%',
    end: 'bottom 50%',
    scrub: true,
  },
  opacity: 1,
  y: 0,
  ease: 'power2.out',
});

// Partículas negras fijas (4 puntas)
const particleContainer = document.getElementById('quote-particles') as HTMLElement;
const positions = [
  { top: '12%', left: '18%' },
  { top: '20%', left: '60%' },
  { top: '85%', left: '20%' },
  { top: '92%', left: '65%' },
  { top: '50%', left: '50%' },
];

positions.forEach(pos => {
  const particle = document.createElement('div');
  particle.classList.add('absolute', 'opacity-10', 'z-0');

  particle.style.width = '20px';
  particle.style.height = '20px';
  particle.style.backgroundColor = '#000';
  particle.style.clipPath =
    'polygon(50% 0%, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0% 50%, 40% 40%)';
  particle.style.top = pos.top;
  particle.style.left = pos.left;
  particle.style.transform = `rotate(${Math.random() * 360}deg)`;
  particle.style.transformOrigin = 'center';

  particleContainer.appendChild(particle);
});

</script>
