---
/*
  Link secundario de sección: texto con subrayado que se dibuja en hover y la flecha en su
  propio círculo, con el mismo cambio de flecha que CtaButton.
*/
interface Props {
  href: string;
  tone?: "light" | "dark";
  class?: string;
}

const { href, tone = "light", class: className } = Astro.props;
const dark = tone === "dark";
---

<a
  href={href}
  class:list={[
    "group inline-flex items-center gap-3 text-[0.9375rem] font-medium",
    dark ? "text-white" : "text-neutral-900",
    className,
  ]}
>
  <span class="relative">
    <slot />
    <span
      aria-hidden="true"
      class:list={[
        "absolute -bottom-1 left-0 h-px w-full origin-right scale-x-0 transition-transform duration-500 ease-out group-hover:origin-left group-hover:scale-x-100",
        dark ? "bg-violet-300" : "bg-violet-600",
      ]}
    ></span>
  </span>
  <span
    aria-hidden="true"
    class:list={[
      "grid size-8 shrink-0 place-items-center overflow-hidden rounded-full border transition-colors duration-300",
      dark
        ? "border-white/20 group-hover:border-violet-400 group-hover:bg-violet-400 group-hover:text-neutral-950"
        : "border-neutral-300 group-hover:border-violet-600 group-hover:bg-violet-600 group-hover:text-white",
    ]}
  >
    <svg class="col-start-1 row-start-1 h-3.5 w-3.5 transition-transform duration-300 ease-out group-hover:translate-x-[180%]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" /></svg>
    <svg class="col-start-1 row-start-1 h-3.5 w-3.5 -translate-x-[180%] transition-transform duration-300 ease-out group-hover:translate-x-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" /></svg>
  </span>
</a>
