---
const features = [
  {
    title: "Precisión en cada diseño",
    body: "Cada caso se planifica en 3D y se valida antes de fabricar, para movimientos predecibles y resultados consistentes.",
    icon: "fa-bullseye",
  },
  {
    title: "Técnicos con experiencia",
    body: "Un equipo clínico que acompaña tu caso de principio a fin, con soporte directo en los detalles que importan.",
    icon: "fa-briefcase",
  },
  {
    title: "Materiales de alta calidad",
    body: "Resinas certificadas con memoria de forma: alineadores resistentes, cómodos y verdaderamente invisibles.",
    icon: "fa-star",
  },
];
---

<section id="por-que-elegirnos" class="relative overflow-hidden bg-[#f7f8fa] py-24 text-neutral-900 md:py-32">
  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <span class="eyebrow text-violet-600">Por qué GO ALIGNER</span>
      <h2 class="mt-5 text-balance text-4xl font-medium tracking-tight md:text-5xl">
        Tecnología avanzada con criterio clínico.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-neutral-500">
        Combinamos un flujo digital de última generación con experiencia real en ortodoncia para ofrecer resultados predecibles y de calidad.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {features.map((item) => (
        <div class="why-item flex flex-col rounded-3xl border border-neutral-200 bg-white p-8 shadow-[0_1px_2px_rgba(0,0,0,.04)] transition-shadow duration-300 hover:shadow-[0_12px_40px_rgba(0,0,0,.06)]">
          <div class="grid size-12 place-items-center rounded-2xl bg-violet-50 text-violet-600">
            <i class={`fa-solid ${item.icon} text-xl`}></i>
          </div>
          <h3 class="mt-7 text-xl font-medium tracking-tight">{item.title}</h3>
          <p class="mt-3 leading-relaxed text-neutral-500">{item.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReduced) {
    gsap.utils.toArray<HTMLElement>(".why-item").forEach((el, i) => {
      gsap.fromTo(el,
        { opacity: 0, y: 20 },
        {
          opacity: 1, y: 0, duration: 0.55, delay: i * 0.08, ease: "power2.out",
          scrollTrigger: { trigger: el, start: "top 88%" },
        }
      );
    });
  }
</script>
