---
const texts = [
  { titleGray: "Precisión en cada", titleWhite: "diseño", icon: "fa fa-bullseye" },
  { titleGray: "Técnicos con", titleWhite: "experiencia", icon: "fa fa-briefcase" },
  { titleGray: "Elaborado con materiales", titleWhite: "de alta calidad", icon: "fa fa-star" },
];
---

<section id="por-que-elegirnos" class="relative py-24 bg-neutral-950 overflow-hidden text-white">
      <div class="absolute inset-0  pointer-events-none z-10">
        <div class="absolute top-0 left-0 w-full h-20 bg-gradient-to-t from-transparent via-black/30 to-neutral-950"></div>
        <div class="absolute bottom-0 left-0 w-full h-20 bg-gradient-to-b from-transparent via-black/30 to-neutral-950"></div>
    </div>
  <!-- Fondo gradiente animado -->
  <div class="absolute inset-0 z-0 bg-gradient-to-br from-violet-900 via-neutral-950 to-cyan-900 animate-gradient-move"></div>

  <!-- Partículas -->
  <div class="absolute inset-0 pointer-events-none z-0" id="why-particles"></div>

  <div class="max-w-6xl mx-auto px-6 text-center relative z-10">
    <h2 class="text-3xl md:text-5xl font-bold mb-4">
      ¿Por qué <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-500 via-indigo-500 to-cyan-500">elegirnos</span>?
    </h2>
    <p class="text-neutral-300 text-lg mb-16 max-w-3xl mx-auto">
      En <span class="font-semibold text-white">Go Aligners</span> combinamos tecnología avanzada con experiencia clínica para ofrecer resultados predecibles y de calidad.
    </p>

    <div class="grid md:grid-cols-3 gap-8">
      {texts.map((item, i) => (
        <div
          class="why-item relative rounded-3xl p-8 flex flex-col items-center text-center backdrop-blur-md border border-white/10 bg-white/5 transition-transform duration-500 hover:scale-[1.03] group overflow-hidden"
          id={`why-item-${i}`}
        >
          <!-- Glow radial -->
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-radial from-violet-500/20 via-transparent to-transparent"></div>

          <!-- Icono -->
          <div class="relative z-10 w-20 h-20 flex items-center justify-center rounded-full bg-white/10 border border-white/20 shadow-lg group-hover:shadow-violet-500/40 transition-all duration-300">
            <i class={`text-3xl ${item.icon} text-violet-300 group-hover:text-violet-400 transition-colors`}></i>
          </div>

          <!-- Texto -->
          <h3 class="text-lg md:text-xl font-medium mt-8 z-10">
            <span class="block text-neutral-400">{item.titleGray}</span>
            <span class="block font-semibold text-white">{item.titleWhite}</span>
          </h3>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes gradient-move {
    0% { background-position: 0% 50% }
    50% { background-position: 100% 50% }
    100% { background-position: 0% 50% }
  }
  .animate-gradient-move {
    background-size: 200% 200%;
    animation: gradient-move 12s ease infinite;
  }
  .bg-radial {
    background: radial-gradient(circle at center, var(--tw-gradient-from), var(--tw-gradient-via), var(--tw-gradient-to));
  }
</style>

<script is:inline>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // Entrada diagonal
  gsap.utils.toArray(".why-item").forEach((el, i) => {
    gsap.fromTo(el,
      { opacity: 0, x: -40, y: 40, scale: 0.95, filter: "blur(6px)" },
      {
        opacity: 1, x: 0, y: 0, scale: 1, filter: "blur(0px)",
        duration: 1, delay: i * 0.1, ease: "power3.out",
        scrollTrigger: { trigger: el, start: "top 85%" }
      }
    );
  });

  // Partículas flotantes
  const container = document.getElementById("why-particles");
  const positions = Array.from({ length: 12 }, () => ({
    top: `${Math.random() * 90}%`,
    left: `${Math.random() * 90}%`,
  }));

  positions.forEach(pos => {
    const p = document.createElement("div");
    p.classList.add("absolute", "opacity-20");
    p.style.width = "20px";
    p.style.height = "20px";
    p.style.background = "linear-gradient(135deg, rgba(139,92,246,.6), rgba(59,130,246,.6))";
    p.style.clipPath = "polygon(50% 0%, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0% 50%, 40% 40%)";
    p.style.top = pos.top;
    p.style.left = pos.left;
    p.style.transform = `rotate(${Math.random() * 360}deg)`;
    container.appendChild(p);

    gsap.to(p, {
      y: `random(-6,6)`,
      x: `random(-6,6)`,
      rotation: `random(-15,15)`,
      duration: 5,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut",
      delay: Math.random() * 2,
    });
  });
</script>
