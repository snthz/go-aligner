---
import { Image } from "astro:assets";
import Background from "../assets/img-4.jpg";
import Video1 from "../assets/video-1.mp4";

interface Props {
  title?: string;
  description?: string;
  button?: string;
}

const {
  title = "Sonríe con confianza.",
  description = "Transforma tu sonrisa con alineadores invisibles. Agenda tu evaluación y da el primer paso hoy mismo.",
  button = "Agendar evaluación",
} = Astro.props;
---

<section class="relative overflow-hidden bg-[#0a0a0b] py-24 text-white md:py-32">
  <!-- soft photographic backdrop -->
  <div class="absolute inset-0 z-0">
    <Image src={Background} alt="" class="h-full w-full scale-105 object-cover opacity-25" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0b] via-[#0a0a0b]/85 to-[#0a0a0b]"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-violet-500/40 to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-6 md:grid-cols-2 md:gap-16">
    <!-- Copy -->
    <div class="text-center md:text-left">
      <h2 class="text-balance text-4xl font-medium leading-[1.08] tracking-tight md:text-6xl">
        {title}
      </h2>
      <p class="mx-auto mt-5 max-w-md text-lg leading-relaxed text-neutral-400 md:mx-0">
        {description}
      </p>
      <div class="mt-9 flex justify-center md:justify-start">
        <a
          href="https://wa.link/42atxt"
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-2 rounded-full bg-white px-8 py-4 font-medium text-neutral-900 transition-colors duration-200 hover:bg-neutral-200"
        >
          {button}
          <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" /></svg>
        </a>
      </div>
    </div>

    <!-- Vertical video -->
    <div class="justify-self-center md:justify-self-end">
      <div class="aspect-[9/16] w-[clamp(220px,70vw,320px)] overflow-hidden rounded-[1.75rem] border border-white/10 shadow-2xl shadow-black/50">
        <video
          id="cta-video"
          class="h-full w-full object-cover"
          data-src={Video1}
          loop
          muted
          playsinline
          preload="none"
        >
          <track kind="captions" label="Español" srclang="es" />
        </video>
      </div>
    </div>
  </div>
</section>

<script>
  /* Lazy-load the heavy video: only fetch + play when the CTA is in view */
  const video = document.getElementById("cta-video") as HTMLVideoElement | null;
  if (video) {
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const src = video.dataset.src;
          if (src && !video.src) video.src = src;
          video.play().catch(() => {});
          obs.disconnect();
        });
      },
      { rootMargin: "200px" }
    );
    io.observe(video);
  }
</script>
