---
import { Image } from "astro:assets";
import Image1 from "../assets/img-4.jpg";
import Video1 from "../assets/video-1.mp4";
---

<section class="relative py-[8em] overflow-hidden text-white">
      <div class="absolute inset-0  pointer-events-none z-20">
        <div class="absolute top-0 left-0 w-full h-24 bg-gradient-to-b from-neutral-950 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full h-24 bg-gradient-to-t from-neutral-950 to-transparent"></div>
    </div>
  <div class="absolute inset-0 z-0">
    <Image src={Image1} alt="Fondo sonrisa" class="w-full h-full object-cover scale-105" />
    <div class="absolute inset-0 bg-gradient-to-br from-black/80 via-black/70 to-neutral-900/90"></div>

    <div class="absolute -top-[10%] -left-[10%] w-[400px] h-[400px] rounded-full bg-violet-500/20 blur-[150px]"></div>
    <div class="absolute bottom-[0%] right-[0%] w-[350px] h-[350px] rounded-full bg-cyan-500/20 blur-[150px]"></div>
  </div>

  <!-- Contenido -->
  <div class="relative z-10 text-center max-w-2xl mx-auto px-3">
    <h2 class="text-4xl md:text-5xl font-semibold mb-4 leading-tight tracking-tight">
      ¡Sonríe con <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-500 via-indigo-500 to-cyan-500">confianza</span>!
    </h2>
    <p class="text-base md:text-lg text-neutral-300 max-w-xl mx-auto">
      Transforma tu sonrisa con nuestros alineadores dentales invisibles.
      Agenda tu consulta hoy y da el primer paso hacia una sonrisa perfecta.
    </p>

    <video
      class="mt-10 w-full max-w-3xl rounded-lg shadow-lg border border-white/20"
      src={Video1}
      autoplay
      loop
      muted
      playsinline
      preload="metadata"
      width="640"
      height="360"
    >
    <track kind="captions" label="Español" srclang="es" />
  </video>
  </div>



  <script >
    const openBtn = document.getElementById("open-video") as HTMLElement;
    const modal = document.getElementById("video-modal")  as HTMLElement;
    const closeBtn = document.getElementById("close-video") as HTMLElement;

    openBtn?.addEventListener("click", () => {
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    });

    closeBtn?.addEventListener("click", () => {
      modal.classList.remove("flex");
      modal.classList.add("hidden");
      const iframe = modal.querySelector("iframe") as HTMLIFrameElement;
      iframe.src = iframe.src; // reset video
    });
  </script>
</section>
