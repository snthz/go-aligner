---
import { Image } from "astro:assets";
import Logo from "../assets/logo.png";
const currentYear = new Date().getFullYear();
---

<footer class="bg-neutral-950 text-neutral-400">
  <div class="max-w-screen-xl mx-auto px-6 py-14 grid gap-10 md:grid-cols-3">
    <!-- Branding -->
    <div>
      <div class="flex items-center gap-3 mb-4">
        <Image src={Logo} alt="Go Aligners Logo" class="h-10 w-auto" loading="lazy" />
        <h2 class="text-2xl font-bold text-white">Go Aligners</h2>
      </div>
      <p class="text-sm leading-relaxed text-neutral-500">
        Tu sonrisa, nuestra prioridad. Transformamos sonrisas con tecnología de vanguardia.
      </p>
    </div>

    <!-- Navegación -->
    <div>
      <h3 class="text-white font-semibold mb-4">Navegación</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="/" class="hover:text-white transition">Inicio</a></li>
        <li><a href="#about" class="hover:text-white transition">¿Por qué elegirnos?</a></li>
        <li><a href="#services" class="hover:text-white transition">Servicios</a></li>
        <li><a href="#work" class="hover:text-white transition">Nuestro trabajo</a></li>
      </ul>
    </div>

    <!-- Contacto / Redes -->
    <div>
      <h3 class="text-white font-semibold mb-4">Contáctanos</h3>
      <ul class="text-sm space-y-2">
        <li>Email: <a href="mailto:contacto@goaligners.com" class="hover:text-white">contacto@goaligners.com</a></li>
        <li>Tel: <a href="tel:+50400000000" class="hover:text-white">+504 0000-0000</a></li>
        <li>Dirección: Calle Falsa 123, Ciudad</li>
      </ul>
      <div class="flex gap-4 mt-4">
        <!-- Placeholder de íconos -->
        <a href="#" aria-label="Instagram" class="hover:text-white">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M7.5 2C4.46 2 2 4.46 2 7.5v9C2 19.54 4.46 22 7.5 22h9c3.04 0 5.5-2.46 5.5-5.5v-9C22 4.46 19.54 2 16.5 2h-9zM12 7c2.76 0 5 2.24 5 5s-2.24 5-5 5a5 5 0 010-10zm6.5-1.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM12 9a3 3 0 100 6 3 3 0 000-6z" />
          </svg>
        </a>
        <a href="#" aria-label="Facebook" class="hover:text-white">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M13 2.05c-5.5 0-9.95 4.45-9.95 9.95C3.05 17.4 7.1 21.3 12 21.9v-7.2H9.5v-2.7H12v-2.05c0-2.5 1.5-3.9 3.7-3.9 1.1 0 2.3.2 2.3.2v2.55h-1.3c-1.3 0-1.7.8-1.7 1.6V12h2.9l-.5 2.7h-2.4v7.2c4.9-.6 8.95-4.5 8.95-9.9 0-5.5-4.45-9.95-9.95-9.95z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-neutral-800 text-center py-6 text-sm">
    © {currentYear} Go Aligners. Todos los derechos reservados.
  </div>
</footer>
