---
import { Image } from "astro:assets";
import Logo from "../assets/logo.png";
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: "#servicios", text: "Servicios" },
  { href: "#nuestro-trabajo", text: "Nuestro trabajo" },
  { href: "#por-que-elegirnos", text: "Por qué elegirnos" },
  { href: "#proceso", text: "Proceso" },
];
---

<footer class="relative overflow-hidden border-t border-white/10 bg-[#0a0a0b] text-neutral-400">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <!-- Branding -->
      <div>
        <div class="mb-5 flex items-center gap-3">
          <Image src={Logo} alt="GO ALIGNER Logo" class="h-9 w-9 rounded-full" loading="lazy" />
          <span class="text-xl font-medium tracking-tight text-white">GO ALIGNER</span>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-neutral-400/90">
          Alineadores invisibles con flujo 100% digital. Tu sonrisa, diseñada en 3D y fabricada con precisión.
        </p>
        <div class="mt-6 flex gap-3">
          <a href="https://www.instagram.com/goaligner.hn/" target="_blank" rel="noopener" aria-label="Instagram" class="grid size-10 place-items-center rounded-full border border-white/10 text-neutral-300 transition-colors hover:border-white/25 hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" x2="17.51" y1="6.5" y2="6.5" /></svg>
          </a>
          <a href="https://www.facebook.com/share/16p88dh3Qr/?mibextid=wwXIfr" target="_blank" rel="noopener" aria-label="Facebook" class="grid size-10 place-items-center rounded-full border border-white/10 text-neutral-300 transition-colors hover:border-white/25 hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg>
          </a>
          <a href="https://www.tiktok.com/@goaligner" target="_blank" rel="noopener" aria-label="TikTok" class="grid size-10 place-items-center rounded-full border border-white/10 text-neutral-300 transition-colors hover:border-white/25 hover:text-white">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 32 32"><path d="M16.656 1.029c1.637-0.025 3.262-0.012 4.886-0.025 0.054 2.031 0.878 3.859 2.189 5.213l-0.002-0.002c1.411 1.271 3.247 2.095 5.271 2.235l0.028 0.002v5.036c-1.912-0.048-3.71-0.489-5.331-1.247l0.082 0.034c-0.784-0.377-1.447-0.764-2.077-1.196l0.052 0.034c-0.012 3.649 0.012 7.298-0.025 10.934-0.103 1.853-0.719 3.543-1.707 4.954l0.020-0.031c-1.652 2.366-4.328 3.919-7.371 4.011l-0.014 0c-0.123 0.006-0.268 0.009-0.414 0.009-1.73 0-3.347-0.482-4.725-1.319l0.040 0.023c-2.508-1.509-4.238-4.091-4.558-7.094l-0.004-0.041c-0.025-0.625-0.037-1.25-0.012-1.862 0.49-4.779 4.494-8.476 9.361-8.476 0.547 0 1.083 0.047 1.604 0.136l-0.056-0.008c0.025 1.849-0.050 3.699-0.050 5.548-0.423-0.153-0.911-0.242-1.42-0.242-1.868 0-3.457 1.194-4.045 2.861l-0.009 0.030c-0.133 0.427-0.21 0.918-0.21 1.426 0 0.206 0.013 0.41 0.037 0.61l-0.002-0.024c0.332 2.046 2.086 3.59 4.201 3.59 0.061 0 0.121-0.001 0.181-0.004l-0.009 0c1.463-0.044 2.733-0.831 3.451-1.994l0.010-0.018c0.267-0.372 0.45-0.822 0.511-1.311l0.001-0.014c0.125-2.237 0.075-4.461 0.087-6.698 0.012-5.036-0.012-10.060 0.025-15.083z" /></svg>
          </a>
        </div>
      </div>

      <!-- Navegación -->
      <div>
        <h3 class="text-sm font-medium text-white">Navegación</h3>
        <ul class="mt-4 space-y-3 text-sm">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="transition-colors duration-200 hover:text-white">{link.text}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="text-sm font-medium text-white">Contacto</h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a href="mailto:goalignerhn@gmail.com" class="transition-colors duration-200 hover:text-white">goalignerhn@gmail.com</a></li>
          <li><a href="tel:+50488561070" class="transition-colors duration-200 hover:text-white">+504 8856-1070</a></li>
          <li class="text-neutral-500">San Pedro Sula, Cortés</li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-7 text-xs text-neutral-500 sm:flex-row">
      <p>© {currentYear} <span class="text-neutral-300">GO ALIGNER</span>. Todos los derechos reservados.</p>
      <p>Desarrollado por <a href="https://fallxnstudio.com" target="_blank" rel="noopener" class="text-neutral-400 transition-colors duration-200 hover:text-white">Fallxn Studio</a></p>
    </div>
  </div>
</footer>
