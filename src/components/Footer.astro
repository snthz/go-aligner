              ></path>
            </g></svg
          >
        </a>
      </div>
    </div>
  </div>

  <!-- Separador y derechos -->
  <div class="border-t border-white/10 text-center py-6 text-sm relative z-10">
    © {currentYear}
    <span class="text-white font-medium">GO ALIGNER</span>. Todos los derechos
    reservados.
  </div>
</footer>
