---
import { Image } from "astro:assets";
import Logo from "../assets/logo.png";
const currentYear = new Date().getFullYear();
---

<footer class="relative text-neutral-400 overflow-hidden">
  <!-- Fondo con gradiente -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-[#0d1117] via-[#0b0d14] to-neutral-950"
  >
  </div>
  <!-- Líneas decorativas -->
  <div
    class="absolute inset-0 opacity-[0.04]"
    style="background-image:linear-gradient(120deg,rgba(255,255,255,.8) 1px,transparent 1px);background-size:20px 20px;"
  >
  </div>

  <!-- Contenido -->
  <div
    class="max-w-screen-xl mx-auto px-6 py-14 grid gap-10 md:grid-cols-3 relative z-10"
  >
    <!-- Branding -->
    <div>
      <div class="flex items-center gap-3 mb-4">
        <Image
          src={Logo}
          alt="GO ALIGNER Logo"
          class="h-10 w-auto"
          loading="lazy"
        />
        <h2 class="text-2xl font-bold text-white">GO ALIGNER</h2>
      </div>
      <p class="text-sm leading-relaxed text-neutral-400/90">
        Tu sonrisa, nuestra prioridad. Transformamos sonrisas con tecnología de
        vanguardia.
      </p>
    </div>

    <!-- Navegación -->
    <div>
      <h3 class="text-white font-semibold mb-4">Navegación</h3>
      <ul class="space-y-2 text-sm">
        <li>
          <a href="/" class="hover:text-white transition-colors duration-200"
            >Inicio</a
          >
        </li>
        <li>
          <a
            href="#about"
            class="hover:text-white transition-colors duration-200"
            >¿Por qué elegirnos?</a
          >
        </li>
        <li>
          <a
            href="#services"
            class="hover:text-white transition-colors duration-200">Servicios</a
          >
        </li>
        <li>
          <a
            href="#work"
            class="hover:text-white transition-colors duration-200"
            >Nuestro trabajo</a
          >
        </li>
      </ul>
    </div>

    <!-- Contacto / Redes -->
    <div>
      <h3 class="text-white font-semibold mb-4">Contáctanos</h3>
      <ul class="text-sm space-y-2">
        <li>
          Email: <a
            href="mailto:goalignerhn@gmail.com"
            class="hover:text-white transition-colors duration-200"
            >goalignerhn@gmail.com</a
          >
        </li>
        <li>
          Tel: <a
            href="tel:+50488561070"
            class="hover:text-white transition-colors duration-200"
            >+504 8856-1070</a
          >
        </li>
      </ul>
      <div class="flex gap-4 mt-4">
        <!-- WhatsApp -->
        <!-- <a
          href="https://wa.link/42atxt"
          target="_blank"
          aria-label="Whatsapp"
          class="hover:text-green-400 transition-colors duration-200"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M6.014 8.00613C6.12827 7.1024 7.30277 5.87414 8.23488 6.01043C9.14051 6.18132 9.85859 7.74261 10.2635 8.44465C10.5504 8.95402 10.3641 9.4701 10.0965 9.68787C9.7355 9.97883 9.17099 10.3803 9.28943 10.7834C9.5 11.5 12 14 13.2296 14.7107C13.695 14.9797 14.0325 14.2702 14.3207 13.9067C14.5301 13.6271 15.0466 13.46 15.5548 13.736C16.3138 14.178 17.0288 14.6917 17.69 15.27C18.0202 15.546 18.0977 15.9539 17.8689 16.385C17.4659 17.1443 16.3003 18.1456 15.4542 17.9421C13.9764 17.5868 8 15.27 6.08033 8.55801C5.97237 8.24048 5.99955 8.12044 6.014 8.00613Z"
            ></path>
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 23C10.7764 23 10.0994 22.8687 9 22.5L6.89443 23.5528C5.56462 24.2177 4 23.2507 4 21.7639V19.5C1.84655 17.492 1 15.1767 1 12C1 5.92487 5.92487 1 12 1C18.0751 1 23 5.92487 23 12C23 18.0751 18.0751 23 12 23ZM6 18.6303L5.36395 18.0372C3.69087 16.4772 3 14.7331 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12C21 16.9706 16.9706 21 12 21C11.0143 21 10.552 20.911 9.63595 20.6038L8.84847 20.3397L6 21.7639V18.6303Z"
            ></path>
          </svg>
        </a> -->

        <!-- Instagram -->
        <a
          href="https://www.instagram.com/goaligner.hn/"
          target="_blank"
          aria-label="Instagram"
          class="hover:text-pink-400 transition-colors duration-200"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
          </svg>
        </a>

        <!-- facebook -->
        <a
          href="https://www.facebook.com/share/16p88dh3Qr/?mibextid=wwXIfr"
          target="_blank"
          aria-label="Facebook"
          class="hover:text-blue-400 transition-colors duration-200"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-facebook-icon lucide-facebook"
            ><path
              d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
            ></path></svg
          >
        </a>

        <!-- tik tok -->
        <a
          href="https://www.tiktok.com/@goaligner?_t=ZM-8ysJk1ze9A5&_r=1"
          target="_blank"
          aria-label="TikTok"
          class="hover:text-blue-400 transition-colors duration-200"
        >
          <svg
            width="24"
            height="24"
            fill="currentColor"
            viewBox="0 0 32 32"
            version="1.1"
            xmlns="http://www.w3.org/2000/svg"
            class="currentColor"
