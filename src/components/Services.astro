---
const services = [
  {
    title: 'Diseño digital de tratamientos',
    description: 'Modelos 3D con simulación del movimiento dental y planificación personalizada según el ortodoncista.',
  },
  {
    title: 'Fabricación de alineadores personalizados',
    description: 'Producción secuencial con tecnología shape memory, basada en el plan digital aprobado.',
  },
  {
    title: 'Escaneo intraoral o recepción de modelos',
    description: 'Escaneo digital de modelos físicos en caso de que la clínica no cuente con escáner propio.',
  },
  {
    title: 'Portal digital para ortodoncistas',
    description: 'Subida de casos, revisión de planes, seguimiento y comunicación directa con técnicos.',
  },
  {
    title: 'Asesoría clínica personalizada',
    description: 'Soporte técnico durante el tratamiento y revisión conjunta de casos complejos.',
  },
  {
    title: 'Fabricación de guías quirúrgicas',
    description: 'Diseño y producción de guías para colocación precisa de mini tornillos o intervenciones.',
  },
  {
    title: 'Retenedores postratamiento',
    description: 'Retenedores a medida para conservar los resultados del tratamiento de ortodoncia.',
  },
  {
    title: 'Capacitación y educación continua',
    description: 'Cursos, webinars y certificaciones para actualizarse en técnicas y protocolos clínicos.',
  },
];
---

<section id="servicios" class="bg-neutral-950 text-white">
  <div class="max-w-5xl mx-auto px-6 py-24">
    <h2 class="text-4xl md:text-6xl font-bold mb-10 text-left ">Servicios</h2>

    <div class="space-y-10">
      {services.map((item, i) => (
        <div class="service-item flex flex-col gap-3" id={`service-${i}`}>
          <div class="flex items-start gap-6">
            <span class="text-slate-400 text-xl font-bold min-w-[30px]">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class=" font-bold text-white text-lg md:text-xl mb-1">{item.title}</h3>
              <p class="text-neutral-400 text-base leading-relaxed">{item.description}</p>
            </div>
          </div>
          <hr class="border-gray-700 mt-4" />
        </div>
      ))}
    </div>
  </div>
</section>

<script >
  import gsap from 'gsap'
  import ScrollTrigger from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  document.querySelectorAll('.service-item').forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, x: -40 },
      {
        opacity: 1,
        x: 0,
        duration: 0.9,
        delay: i * 0.05,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 90%',
        },
      }
    )
  })
</script>
