---
interface Service {
  title: string;
  icon: string;
  description: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  services: Service[];
}

const { id, eyebrow, title, description, services } = Astro.props;

// Tailwind necesita clases literales
const cols = services.length % 4 === 0 ? "lg:grid-cols-4" : "lg:grid-cols-3";
---

<section id={id} class:list={["relative overflow-hidden bg-[#0a0a0b] text-white", title ? "py-24 md:py-32" : "pb-24 pt-16 md:pb-32 md:pt-20"]}>
  <div class="relative z-10 mx-auto max-w-6xl px-6">
    {title && (
      <div class="mb-14 max-w-2xl">
        {eyebrow && <span class="eyebrow text-violet-300">{eyebrow}</span>}
        <h2 class="mt-5 text-balance text-4xl font-medium tracking-tight md:text-5xl">{title}</h2>
        {description && <p class="mt-5 text-lg leading-relaxed text-neutral-400">{description}</p>}
      </div>
    )}

    <!-- grid -->
    <div class:list={["grid grid-cols-1 gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/[0.06] sm:grid-cols-2", cols]}>
      {services.map((item, i) => (
        <article class="service-card group relative flex flex-col bg-[#0a0a0b] p-7 transition-colors duration-300 hover:bg-white/[0.025]">
          <div class="flex items-center justify-between">
            <div class="grid size-11 place-items-center rounded-xl border border-violet-400/20 bg-violet-500/10 text-violet-300 transition-colors duration-300 group-hover:border-violet-400/40">
              <i class={`fa-solid ${item.icon} text-lg`}></i>
            </div>
            <span class="text-sm tabular-nums text-neutral-600">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <h3 class="mt-6 text-lg font-medium leading-snug">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-400">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReduced) {
    ScrollTrigger.batch(".service-card", {
      start: "top 92%",
      once: true,
      onEnter: (els) =>
        gsap.fromTo(els,
          { opacity: 0, y: 18 },
          { opacity: 1, y: 0, duration: 0.5, stagger: 0.05, ease: "power2.out" }
        ),
    });
  }
</script>
