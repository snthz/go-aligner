---
const services = [
  { title: "Diseño digital de tratamientos", description: "Modelos 3D con simulación del movimiento dental y planificación personalizada según el ortodoncista." },
  { title: "Fabricación de alineadores personalizados", description: "Producción secuencial con tecnología shape memory, basada en el plan digital aprobado." },
  { title: "Escaneo intraoral o recepción de modelos", description: "Escaneo digital de modelos físicos en caso de que la clínica no cuente con escáner propio." },
  { title: "Portal digital para ortodoncistas", description: "Subida de casos, revisión de planes, seguimiento y comunicación directa con técnicos." },
  { title: "Asesoría clínica personalizada", description: "Soporte técnico durante el tratamiento y revisión conjunta de casos complejos." },
  { title: "Fabricación de guías quirúrgicas", description: "Diseño y producción de guías para colocación precisa de mini tornillos o intervenciones." },
  { title: "Retenedores postratamiento", description: "Retenedores a medida para conservar los resultados del tratamiento de ortodoncia." },
  { title: "Capacitación y educación continua", description: "Cursos, webinars y certificaciones para actualizarse en técnicas y protocolos clínicos." },
];
---

<section id="servicios" class="relative text-white overflow-hidden py-20 md:py-28 bg-neutral-950">
      <div class="absolute inset-0  pointer-events-none z-20">
        <div class="absolute top-0 left-0 w-full h-20 bg-gradient-to-t from-transparent via-black/30 to-neutral-950"></div>
        <div class="absolute bottom-0 left-0 w-full h-20 bg-gradient-to-b from-transparent via-black/30 to-neutral-950"></div>
    </div>
  <!-- Fondo tipo “logo”: negro + diagonales + luces -->
  <div class="absolute inset-0 z-10">
    <!-- base negra con ligerísimo degradado -->
    <div class="absolute inset-0 bg-[radial-gradient(120%_80%_at_50%_-10%,#0f0b15,transparent_60%),linear-gradient(180deg,#08090b, #0a0a0f_30%,#0b0a10_70%,#0a0a0f)]"></div>

    <!-- líneas diagonales finas (como el poster) -->
    <div
      class="absolute inset-0 opacity-[0.08]"
      style="
        background-image:
          repeating-linear-gradient(110deg, rgba(168,85,247,0.65) 0 1px, transparent 1px 9px);
        mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
      "
    ></div>

    <!-- bandas diagonales suaves (sombras moradas) -->
    <div
      class="absolute inset-0 opacity-[0.18] "
      style="
        background-image:
          linear-gradient(115deg, transparent 30%, rgba(119,33,208,.15) 45%, transparent 65%),
          linear-gradient(295deg, transparent 35%, rgba(59,130,246,.10) 55%, transparent 70%);
      "
    ></div>

    <!-- glows sutiles en esquinas (muy bajos) -->
    <div class="absolute -top-24 -left-24 w-[28rem] h-[28rem] bg-[#7c3aed]/20 blur-3xl rounded-full"></div>
    <div class="absolute bottom-[-6rem] right-[-6rem] w-[26rem] h-[26rem] bg-[#2563eb]/20 blur-3xl rounded-full"></div>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-10 md:mb-14">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/5 px-3 py-1 text-sm text-neutral-200 backdrop-blur border border-white/10">
        Servicios
      </span>
      <h2 class="mt-3 text-3xl md:text-5xl font-bold tracking-tight">
        Nuestros <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#cfcfd4] via-[#e5e7eb] to-[#cfcfd4]">servicios</span>
      </h2>
      <p class="text-neutral-300 text-base md:text-lg mt-3 max-w-3xl mx-auto">
        Soluciones de ortodoncia digital con precisión, soporte y resultados predecibles.
      </p>
      <!-- subrayado con tono plata + violeta muy sutil -->
      <div class="mx-auto mt-4 h-[2px] w-44 bg-gradient-to-r from-[#a78bfa]/60 via-white/60 to-transparent"></div>
    </div>

    <!-- Grid -->
    <div class="grid md:grid-cols-2 gap-6 md:gap-8">
      {services.map((item, i) => (
        <article class="service-card relative group">
          <!-- marco gradiente sutil (evita halo blanco) -->
          <div class="rounded-3xl p-[1px] bg-[linear-gradient(90deg,rgba(139,92,246,.9),rgba(59,130,246,.9))] shadow-[0_16px_44px_rgba(59,130,246,.18)]">
            <div class="relative rounded-3xl bg-white/5 backdrop-blur-md p-6 md:p-7">
              <!-- highlight suave al hover -->
              <span class="pointer-events-none absolute -top-14 -left-10 w-48 h-48 bg-white/10 blur-3xl rounded-full opacity-0 group-hover:opacity-25 transition-opacity duration-700"></span>

              <!-- badge número -->
              <div class="absolute -left-4 -top-4">
                <div class="w-10 h-10 rounded-full grid place-items-center font-bold text-neutral-900 bg-white shadow-[0_0_14px_rgba(139,92,246,.55),0_0_22px_rgba(59,130,246,.45)]">
                  {String(i + 1)}
                </div>
              </div>

              <!-- contenido -->
              <header class="flex items-start gap-3 md:gap-4">
                <div class="shrink-0 rounded-xl bg-white/10 p-3">
                  <!-- icono alineador -->
                  <svg viewBox="0 0 64 24" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 12c6-9 16-9 22 0s16 9 22 0 14-9 14 0" />
                    <circle cx="15" cy="12" r="1.2"/><circle cx="27" cy="12" r="1.2"/><circle cx="39" cy="12" r="1.2"/><circle cx="51" cy="12" r="1.2"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <h3 class="text-lg md:text-xl font-semibold text-white">{item.title}</h3>
                  <p class="text-neutral-300 mt-1 leading-relaxed">{item.description}</p>
                </div>
              </header>

              <!-- línea interior muy discreta -->
              <div class="mt-4 h-px bg-gradient-to-r from-transparent via-white/25 to-transparent"></div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  if (typeof window !== "undefined") {
    gsap.registerPlugin(ScrollTrigger);

    ScrollTrigger.batch(".service-card", {
      onEnter: (batch) => {
        gsap.fromTo(
          batch,
          { y: 36, opacity: 0, filter: "blur(6px)" },
          { y: 0, opacity: 1, filter: "blur(0px)", duration: 0.8, stagger: 0.12, ease: "power3.out" }
        );
      },
      once: true,
      start: "top 88%",
    });

    document.querySelectorAll(".service-card").forEach((card) => {
      card.addEventListener("mouseenter", () => {
        gsap.to(card, { y: -6, duration: 0.3, ease: "power2.out" });
      });
      card.addEventListener("mouseleave", () => {
        gsap.to(card, { y: 0, duration: 0.35, ease: "power2.out" });
      });
    });
  }
</script>
