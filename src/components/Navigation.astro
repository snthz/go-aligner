---
import LogoImage from "../assets/logo.png";

const links = [
  { href: "#servicios", text: "Servicios", sectionId: "servicios" },
  { href: "#nuestro-trabajo", text: "Trabajo", sectionId: "nuestro-trabajo" },
  { href: "#por-que-elegirnos", text: "Por qué", sectionId: "por-que-elegirnos" },
  { href: "#proceso", text: "Proceso", sectionId: "proceso" },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 px-4 pt-4 md:pt-5">
  <nav
    id="nav-pill"
    class="mx-auto flex max-w-3xl items-center justify-between gap-3 rounded-full border border-white/10 bg-[#0a0a0b]/70 px-3 py-2 pl-4 backdrop-blur-xl transition-shadow duration-300"
    aria-label="Navegación principal"
  >
    <!-- Brand -->
    <a href="/" class="flex shrink-0 items-center gap-2.5">
      <img src={LogoImage.src} alt="GO ALIGNER logo" class="h-7 w-7 rounded-full" width="28" height="28" />
      <span class="text-[0.95rem] font-medium tracking-tight text-white">GO ALIGNER</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-1 md:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            data-section={link.sectionId}
            class="nav-link rounded-full px-3 py-1.5 text-[0.8rem] text-neutral-400 transition-colors duration-200 hover:text-white"
          >
            {link.text}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a
        href="https://wa.link/42atxt"
        target="_blank"
        rel="noopener"
        class="hidden items-center gap-1.5 rounded-full bg-white px-4 py-2 text-[0.8rem] font-medium text-neutral-900 transition-colors duration-200 hover:bg-neutral-200 sm:inline-flex"
      >
        Agendar
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
        </svg>
      </a>

      <!-- Mobile button -->
      <button
        class="inline-flex h-9 w-9 items-center justify-center rounded-full text-neutral-200 hover:bg-white/10 md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        data-nav-toggle
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Drawer mobile -->
  <div
    id="mobile-drawer"
    class="pointer-events-none fixed inset-0 translate-y-[-8px] bg-[#0a0a0b]/95 opacity-0 backdrop-blur-xl transition-all duration-300 md:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
  >
    <div class="flex h-full flex-col items-center justify-center gap-7 px-6">
      <button class="absolute right-5 top-5 p-2 text-white" aria-label="Cerrar menú" data-nav-toggle>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M18 6 6 18M6 6l12 12" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>

      {links.map((link) => (
        <a href={link.href} data-mobile-link class="text-2xl font-medium tracking-tight text-white transition hover:text-neutral-400">
          {link.text}
        </a>
      ))}

      <a
        href="https://wa.link/42atxt"
        target="_blank"
        rel="noopener"
        class="mt-3 inline-flex items-center gap-2 rounded-full bg-white px-7 py-3 font-medium text-neutral-900"
      >
        Agendar evaluación
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  /* ── Mobile drawer toggle ── */
  const toggles = document.querySelectorAll("[data-nav-toggle]");
  const drawer = document.getElementById("mobile-drawer") as HTMLElement;

  const closeDrawer = () => {
    drawer.classList.add("opacity-0", "pointer-events-none");
    drawer.classList.remove("opacity-100");
    toggles.forEach((btn) => btn.setAttribute("aria-expanded", "false"));
  };
  const openDrawer = () => {
    drawer.classList.remove("opacity-0", "pointer-events-none");
    drawer.classList.add("opacity-100");
    toggles.forEach((btn) => btn.setAttribute("aria-expanded", "true"));
  };

  toggles.forEach((btn) =>
    btn.addEventListener("click", () => {
      const isOpen = drawer.classList.contains("opacity-100");
      isOpen ? closeDrawer() : openDrawer();
    })
  );
  document.querySelectorAll("[data-mobile-link]").forEach((a) =>
    a.addEventListener("click", closeDrawer)
  );

  /* ── Pill elevation on scroll ── */
  const pill = document.getElementById("nav-pill") as HTMLElement;
  ScrollTrigger.create({
    start: "top -20",
    end: 99999,
    onUpdate: (self) => {
      const scrolled = self.scroll() > 24;
      pill.style.boxShadow = scrolled ? "0 12px 40px rgba(0,0,0,.45)" : "none";
      pill.style.borderColor = scrolled ? "rgba(255,255,255,.14)" : "rgba(255,255,255,.10)";
    },
  });

  /* ── Active nav link on scroll ── */
  const navLinks = document.querySelectorAll(".nav-link") as NodeListOf<HTMLAnchorElement>;
  const setActiveLink = (sectionId: string) => {
    navLinks.forEach((link) => {
      const isActive = link.dataset.section === sectionId;
      link.classList.toggle("text-white", isActive);
      link.classList.toggle("bg-white/10", isActive);
      link.classList.toggle("text-neutral-400", !isActive);
    });
  };

  ["servicios", "nuestro-trabajo", "por-que-elegirnos", "proceso"].forEach((id) => {
    const el = document.getElementById(id);
    if (!el) return;
    ScrollTrigger.create({
      trigger: el,
      start: "top center",
      end: "bottom center",
      onEnter: () => setActiveLink(id),
      onEnterBack: () => setActiveLink(id),
    });
  });
</script>
