---
import LogoImage from "../assets/logo.png";

const links = [
  { href: "/", text: "Inicio" },
  { href: "/#servicios", text: "Servicios" },
  { href: "/#nuestro-trabajo", text: "Nuestro trabajo" },
  { href: "/#por-que-elegirnos", text: "¿Por qué elegirnos?" },
];
---

<header id="site-header" class="fixed top-0 w-full z-50 transition-all">
  <!-- fondo/blur + borde gradiente -->
  <div class="absolute inset-0 backdrop-blur-md bg-neutral-950/60"></div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-violet-500/40 via-white/20 to-sky-500/40"></div>

  <nav class="relative max-w-screen-xl mx-auto px-4 md:px-6">
    <div class="flex items-center justify-between py-4 md:py-5">
      <!-- Brand -->
      <a href="/" class="flex items-center gap-3">
        <img src={LogoImage.src} alt="Logo Aligner" class="h-9 w-9 rounded-md" />
        <span class="text-lg md:text-xl font-semibold tracking-tight text-white">
          ALIGNER
        </span>
      </a>

      <!-- Desktop -->
      <ul class="hidden md:flex items-center gap-2">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="group px-4 py-2 text-sm text-neutral-200 hover:text-white transition-colors relative"
            >
              {link.text}
              <span class="absolute left-1/2 -bottom-0.5 h-[2px] w-0 group-hover:w-3/4 -translate-x-1/2 bg-gradient-to-r from-violet-400 to-sky-400 transition-all"></span>
            </a>
          </li>
        ))}
        <li>
          <a
            href="https://wa.link/42atxt"
            target="_blank"
            class="ml-2 inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/10 px-4 py-2 text-sm text-white hover:bg-white/15 transition"
          >
            Contacto
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="-mr-0.5">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </li>
      </ul>

      <!-- Mobile button -->
      <button
        class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg text-neutral-200 hover:text-white focus:outline-none"
        aria-label="Abrir menú"
        data-nav-toggle
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Drawer mobile -->
  <div
    id="mobile-drawer"
    class="fixed inset-0 bg-neutral-950/90 backdrop-blur-md translate-y-[-8px] opacity-0 pointer-events-none transition-all duration-300 md:hidden"
  >
    <div class="absolute top-0 left-0 w-full h-20 bg-gradient-to-b from-black/40 to-transparent"></div>

    <div class="h-full flex flex-col items-center justify-center gap-8 px-6">
      <!-- close -->
      <button class="absolute top-5 right-5 text-white" aria-label="Cerrar menú" data-nav-toggle>
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M18 6 6 18M6 6l12 12" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>

      {links.map((link) => (
        <a
          href={link.href}
          name="link-mob"
          class="text-white text-xl font-medium hover:text-neutral-300 transition"
        >
          {link.text}
        </a>
      ))}

      <a
        href="https://wa.link/42atxt"
        target="_blank"
        class="mt-2 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-6 py-2 text-white hover:bg-white/10 transition"
      >
        Contacto
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  // Toggle móvil
  const toggles = document.querySelectorAll('[data-nav-toggle]');
  const drawer = document.getElementById('mobile-drawer');
  const closeOnLink = () => {
    drawer.classList.add('opacity-0','pointer-events-none');
    drawer.classList.remove('opacity-100');
  };
  toggles.forEach(btn => btn.addEventListener('click', () => {
    const open = drawer.classList.contains('opacity-100');
    drawer.classList.toggle('opacity-100', !open);
    drawer.classList.toggle('pointer-events-none', open);
  }));
  document.querySelectorAll('#mobile-drawer a[name="link-mob"]').forEach(a =>
    a.addEventListener('click', closeOnLink)
  );

  // Header shrink on scroll
  const header = document.getElementById('site-header');
  let lastY = 0;
  window.addEventListener('scroll', () => {
    const y = window.scrollY || 0;
    const shrink = y > 12;
    header.style.boxShadow = shrink ? '0 6px 24px rgba(0,0,0,.35)' : 'none';
    header.querySelector('nav > div').classList.toggle('py-3', shrink);
    header.querySelector('nav > div').classList.toggle('py-5', !shrink);
    lastY = y;
  });
</script>
