---
import LogoImage from "../assets/logo.png";

const links = [
  { href: "#hero", text: "Inicio", sectionId: "hero" },
  { href: "#servicios", text: "Servicios", sectionId: "servicios" },
  { href: "#nuestro-trabajo", text: "Nuestro trabajo", sectionId: "nuestro-trabajo" },
  { href: "#por-que-elegirnos", text: "¿Por qué elegirnos?", sectionId: "por-que-elegirnos" },
];
---

<header id="site-header" class="fixed top-0 w-full z-50">
  <!-- fondo/blur + borde gradiente -->
  <div id="header-bg" class="absolute inset-0 backdrop-blur-md bg-neutral-950/60 transition-colors duration-300"></div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-violet-500/40 via-white/10 to-sky-500/40"></div>

  <nav class="relative max-w-screen-xl mx-auto px-4 md:px-6" aria-label="Navegación principal">
    <div id="nav-inner" class="flex items-center justify-between py-5">
      <!-- Brand -->
      <a href="/" class="flex items-center gap-3">
        <img src={LogoImage.src} alt="GO ALIGNER logo" class="h-9 w-9 rounded-md" width="36" height="36" />
        <span class="text-lg md:text-xl font-semibold tracking-tight text-white">
         GO ALIGNER
        </span>
      </a>

      <!-- Desktop -->
      <ul class="hidden md:flex items-center gap-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              data-section={link.sectionId}
              class="nav-link group px-4 py-2 text-xs text-neutral-400 hover:text-white transition-colors duration-200 relative uppercase tracking-wide"
            >
              {link.text}
              <span class="nav-indicator absolute left-1/2 -bottom-0.5 h-[2px] w-0 -translate-x-1/2 bg-gradient-to-r from-violet-400 to-sky-400 transition-all duration-300"></span>
            </a>
          </li>
        ))}
        <li>
          <a
            href="https://wa.link/42atxt"
            target="_blank"
            rel="noopener"
            class="ml-3 inline-flex items-center gap-2 rounded-full bg-white/[.06] border border-white/10 px-4 py-2 text-sm text-white hover:bg-white/10 transition-colors duration-200"
          >
            Contacto
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="-mr-0.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/>
            </svg>
          </a>
        </li>
      </ul>

      <!-- Mobile button -->
      <button
        class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg text-neutral-200 hover:text-white focus-visible:ring-2 focus-visible:ring-violet-500"
        aria-label="Abrir menú"
        aria-expanded="false"
        data-nav-toggle
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Drawer mobile -->
  <div
    id="mobile-drawer"
    class="fixed inset-0 bg-neutral-950/95 backdrop-blur-lg translate-y-[-8px] opacity-0 pointer-events-none transition-all duration-300 md:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
  >
    <div class="h-full flex flex-col items-center justify-center gap-8 px-6">
      <button class="absolute top-5 right-5 text-white p-2" aria-label="Cerrar menú" data-nav-toggle>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M18 6 6 18M6 6l12 12" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>

      {links.map((link) => (
        <a
          href={link.href}
          data-mobile-link
          class="text-white text-xl font-medium hover:text-neutral-300 transition uppercase"
        >
          {link.text}
        </a>
      ))}

      <a
        href="https://wa.link/42atxt"
        target="_blank"
        rel="noopener"
        class="mt-2 inline-flex items-center justify-center gap-2 rounded-full border border-white/15 bg-white/5 px-6 py-3 text-white hover:bg-white/10 transition uppercase"
      >
        Contacto
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  /* ── Mobile drawer toggle ── */
  const toggles = document.querySelectorAll("[data-nav-toggle]");
  const drawer = document.getElementById("mobile-drawer") as HTMLElement;

  const closeDrawer = () => {
    drawer.classList.add("opacity-0", "pointer-events-none");
    drawer.classList.remove("opacity-100");
    toggles.forEach((btn) => btn.setAttribute("aria-expanded", "false"));
  };
  const openDrawer = () => {
    drawer.classList.remove("opacity-0", "pointer-events-none");
    drawer.classList.add("opacity-100");
    toggles.forEach((btn) => btn.setAttribute("aria-expanded", "true"));
  };

  toggles.forEach((btn) =>
    btn.addEventListener("click", () => {
      const isOpen = drawer.classList.contains("opacity-100");
      isOpen ? closeDrawer() : openDrawer();
    })
  );
  document.querySelectorAll("[data-mobile-link]").forEach((a) =>
    a.addEventListener("click", closeDrawer)
  );

  /* ── Header shrink with GSAP ── */
  const header = document.getElementById("site-header") as HTMLElement;
  const headerBg = document.getElementById("header-bg") as HTMLElement;
  const navInner = document.getElementById("nav-inner") as HTMLElement;
  let shrunk = false;

  ScrollTrigger.create({
    start: "top -20",
    end: 99999,
    onUpdate: (self) => {
      const shouldShrink = self.scroll() > 20;
      if (shouldShrink === shrunk) return;
      shrunk = shouldShrink;

      gsap.to(navInner, {
        paddingTop: shouldShrink ? "0.6rem" : "1.25rem",
        paddingBottom: shouldShrink ? "0.6rem" : "1.25rem",
        duration: 0.3,
        ease: "power2.out",
      });
      gsap.to(header, {
        boxShadow: shouldShrink ? "0 4px 20px rgba(0,0,0,.35)" : "none",
        duration: 0.3,
      });
      headerBg.style.backgroundColor = shouldShrink
        ? "rgba(10,10,10,.85)"
        : "rgba(10,10,10,.6)";
    },
  });

  /* ── Active nav link on scroll ── */
  const navLinks = document.querySelectorAll(".nav-link") as NodeListOf<HTMLAnchorElement>;

  const setActiveLink = (sectionId: string) => {
    navLinks.forEach((link) => {
      const isActive = link.dataset.section === sectionId;
      const indicator = link.querySelector(".nav-indicator") as HTMLElement;
      if (isActive) {
        link.classList.replace("text-neutral-400", "text-white");
        if (indicator) indicator.style.width = "70%";
      } else {
        link.classList.replace("text-white", "text-neutral-400");
        if (indicator) indicator.style.width = "0";
      }
    });
  };

  // Observe each section
  const sectionIds = ["hero", "servicios", "nuestro-trabajo", "por-que-elegirnos"];
  sectionIds.forEach((id) => {
    const el = document.getElementById(id);
    if (!el) return;
    ScrollTrigger.create({
      trigger: el,
      start: "top center",
      end: "bottom center",
      onEnter: () => setActiveLink(id),
      onEnterBack: () => setActiveLink(id),
    });
  });
</script>
