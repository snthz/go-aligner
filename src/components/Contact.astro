---
const MAP_QUERY = encodeURIComponent("San Pedro Sula, Cortés, Honduras");
---

<section class="relative overflow-hidden bg-[#0a0a0b] pb-24 pt-16 text-white md:pb-32 md:pt-20">
  <div class="mx-auto grid max-w-6xl gap-6 px-6 md:grid-cols-[1.2fr_1fr]">
    <!-- Mapa -->
    <div class="overflow-hidden rounded-3xl border border-white/10 bg-white/[0.02]">
      <iframe
        title="Mapa de ubicación de GO ALIGNER en San Pedro Sula"
        src={`https://www.google.com/maps?q=${MAP_QUERY}&output=embed`}
        class="h-72 w-full grayscale-[0.4] md:h-full md:min-h-[26rem]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>

    <!-- Datos de contacto -->
    <div class="grid gap-4">
      <a
        href="https://wa.link/42atxt"
        target="_blank"
        rel="noopener"
        class="group flex items-center gap-4 rounded-3xl border border-[#25D366]/30 bg-[#25D366]/10 p-6 transition-colors hover:bg-[#25D366]/15"
      >
        <div class="grid size-11 shrink-0 place-items-center rounded-xl bg-[#25D366] text-white">
          <i class="fa-brands fa-whatsapp text-xl" aria-hidden="true"></i>
        </div>
        <div>
          <p class="text-sm text-neutral-400">WhatsApp · agenda tu evaluación</p>
          <p class="text-lg font-medium">+504 8856-1070</p>
        </div>
      </a>

      <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
        <div class="rounded-3xl border border-white/10 bg-white/[0.02] p-6">
          <i class="fa-regular fa-clock text-violet-300" aria-hidden="true"></i>
          <p class="mt-3 text-sm text-neutral-400">Horario</p>
          <p class="font-medium">Lunes a viernes, 8am–5pm</p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/[0.02] p-6">
          <i class="fa-solid fa-location-dot text-violet-300" aria-hidden="true"></i>
          <p class="mt-3 text-sm text-neutral-400">Ubicación</p>
          <p class="font-medium">San Pedro Sula, Cortés</p>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${MAP_QUERY}`}
            target="_blank"
            rel="noopener"
            class="mt-1 inline-block text-sm text-violet-300 hover:text-white"
          >Cómo llegar →</a>
        </div>
      </div>

      <a href="mailto:goalignerhn@gmail.com" class="flex items-center gap-4 rounded-3xl border border-white/10 bg-white/[0.02] p-6 transition-colors hover:border-white/20">
        <i class="fa-regular fa-envelope text-violet-300" aria-hidden="true"></i>
        <div>
          <p class="text-sm text-neutral-400">Correo</p>
          <p class="font-medium">goalignerhn@gmail.com</p>
        </div>
      </a>

      <div class="flex items-center justify-between gap-4 rounded-3xl border border-white/10 bg-white/[0.02] p-6">
        <p class="text-sm text-neutral-400">Síguenos</p>
        <div class="flex gap-3">
          <a href="https://www.instagram.com/goaligner.hn/" target="_blank" rel="noopener" aria-label="Instagram" class="grid size-10 place-items-center rounded-full border border-white/10 text-neutral-300 transition-colors hover:border-white/25 hover:text-white">
            <i class="fa-brands fa-instagram" aria-hidden="true"></i>
          </a>
          <a href="https://www.facebook.com/share/16p88dh3Qr/?mibextid=wwXIfr" target="_blank" rel="noopener" aria-label="Facebook" class="grid size-10 place-items-center rounded-full border border-white/10 text-neutral-300 transition-colors hover:border-white/25 hover:text-white">
            <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
          </a>
          <a href="https://www.tiktok.com/@goaligner" target="_blank" rel="noopener" aria-label="TikTok" class="grid size-10 place-items-center rounded-full border border-white/10 text-neutral-300 transition-colors hover:border-white/25 hover:text-white">
            <i class="fa-brands fa-tiktok" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
