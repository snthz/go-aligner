---
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";
import Social from "../components/Social.astro";
import "../styles/global.css";

const SITE_NAME = "GO ALIGNER";
const DEFAULT_TITLE = "GO ALIGNER | Alineadores Invisibles y Ortodoncia Digital en Honduras";
const DEFAULT_DESC =
  "Diseñamos y fabricamos alineadores dentales invisibles con flujo 100% digital. Plan 3D, seguimiento online y material shape memory. San Pedro Sula, Honduras.";


const baseOrigin = Astro.site?.origin ?? "https://www.goalignerhn.com";
const currentPath = Astro.url.pathname;
const CANONICAL = `${baseOrigin}${currentPath === "/" ? "" : currentPath}`;

const OG_IMAGE = `${baseOrigin}/og/og-image.png`; 
const FAVICON = "/favicon.png"; 

// Redes oficiales
const SOCIALS = [
  "https://www.instagram.com/goaligner.hn/",
  "https://www.facebook.com/share/16p88dh3Qr/?mibextid=wwXIfr",
  "https://www.tiktok.com/@goaligner",
];

const BUSINESS = {
  legalName: "GO ALIGNER",
  telephone: "+504 8856-1070",
  email: "goalignerhn@gmail.com",
  address: {
    streetAddress: "San Pedro Sula, Cortés",
    addressLocality: "San Pedro Sula",
    addressRegion: "Cortés",
    postalCode: "2100",
    addressCountry: "HN",
  },
  openingHours: ["Mo-Fr 09:00-18:00", "Sa 09:00-13:00"],
};
---

<!doctype html>
<html lang="es-HN" prefix="og: http://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href={FAVICON} />

    <!-- Básicos -->
    <title>{DEFAULT_TITLE}</title>
    <meta name="description" content={DEFAULT_DESC} />
    <link rel="canonical" href={CANONICAL} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#7c3aed" />
    <meta name="generator" content={Astro.generator} />

    <!-- Verificación Google -->
    <meta name="google-site-verification" content="H1RZomOSMOwIDRzRbesvxyvaJoX0V4HcSH0bCej7M1s" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={DEFAULT_TITLE} />
    <meta property="og:description" content={DEFAULT_DESC} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={CANONICAL} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GO ALIGNER - Alineadores invisibles en Honduras" />
    <meta property="og:locale" content="es_HN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={DEFAULT_TITLE} />
    <meta name="twitter:description" content={DEFAULT_DESC} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content="GO ALIGNER - Alineadores invisibles en Honduras" />


    <!-- Hreflang -->
    <link rel="alternate" hreflang="es-HN" href={CANONICAL} />
    <link rel="alternate" hreflang="x-default" href={CANONICAL} />

    <!-- Sitemap & Manifest -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Font Awesome — async (non-render-blocking) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
      integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
        crossorigin="anonymous"
      />
    </noscript>

    <!-- JSON-LD Organization -->
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": SITE_NAME,
        "url": baseOrigin,
        "logo": `${baseOrigin}/logo.png`,
        "sameAs": SOCIALS
      })}
    </script>

    <!-- JSON-LD WebSite -->
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": SITE_NAME,
        "url": baseOrigin
      })}
    </script>

    <!-- JSON-LD Dentist (LocalBusiness) -->
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Dentist",
        "name": SITE_NAME,
        "image": OG_IMAGE,
        "url": baseOrigin,
        "telephone": BUSINESS.telephone,
        "email": BUSINESS.email,
        "address": {
          "@type": "PostalAddress",
          "streetAddress": BUSINESS.address.streetAddress,
          "addressLocality": BUSINESS.address.addressLocality,
          "addressRegion": BUSINESS.address.addressRegion,
          "postalCode": BUSINESS.address.postalCode,
          "addressCountry": BUSINESS.address.addressCountry
        },
        "areaServed": { "@type": "Country", "name": "Honduras" },
        "openingHours": BUSINESS.openingHours,
        "priceRange": "$$",
        "sameAs": SOCIALS
      })}
    </script>

    <!-- JSON-LD Service -->
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        "serviceType": "Fabricación de Alineadores Dentales Invisibles",
        "provider": {
          "@type": "Dentist",
          "name": SITE_NAME,
          "url": baseOrigin
        },
        "areaServed": { "@type": "Country", "name": "Honduras" },
        "description": DEFAULT_DESC
      })}
    </script>
  </head>

  <body class="bg-[#0a0a0b]">
    <a href="#main-content" class="skip-to-content">Saltar al contenido principal</a>
    <Navigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <Social />
  </body>
</html>

